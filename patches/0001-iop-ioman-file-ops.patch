+    void IopIoman::closeAllFiles()
+    {
+        for (const auto &[fd, file] : m_files)
+        {
+            (void)fd;
+            m_host.closeHostFile(file.handle);
+        }
+        m_files.clear();
+        m_nextFd = 1u;
+    }
+
+    int32_t IopIoman::open(uint32_t pathAddress, uint32_t flags)
+    {
+        // Only read access to host-backed devices (cdrom0:, host:) is provided. Writes from
+        // IRX modules would need a writable device model and are rejected.
+        if ((flags & kOpenAccessMask) != kOpenRead)
+            return kEacces;
+        if (m_files.size() >= kMaxOpenFiles)
+            return kEmfile;
+
+        const std::string guestPath = m_memory.readString(pathAddress, 256u);
+        const std::string hostPath = m_host.translateGuestPath(guestPath);
+        const uint64_t handle = hostPath.empty() ? 0u : m_host.openHostFile(hostPath);
+        if (handle == 0u)
+        {
+            m_host.log(LogLevel::Warning, "[ioman] open failed: " + guestPath);
+            return kEnoent;
+        }
+
+        File file;
+        file.handle = handle;
+        if (!m_host.hostFileSize(handle, file.size))
+            file.size = 0u;
+
+        while (m_files.count(m_nextFd) != 0u)
+            ++m_nextFd;
+        const uint32_t fd = m_nextFd++;
+        m_files[fd] = file;
+        return static_cast<int32_t>(fd);
+    }
+
+    int32_t IopIoman::close(uint32_t fd)
+    {
+        const auto it = m_files.find(fd);
+        if (it == m_files.end())
+            return kEbadf;
+        m_host.closeHostFile(it->second.handle);
+        m_files.erase(it);
+        return 0;
+    }
+
+    int32_t IopIoman::read(uint32_t fd, uint32_t buffer, uint32_t size)
+    {
+        const auto it = m_files.find(fd);
+        if (it == m_files.end())
+            return kEbadf;
+        File &file = it->second;
+        if (file.position >= file.size || size == 0u)
+            return 0;
+
+        const uint64_t wanted = std::min<uint64_t>(size, file.size - file.position);
+        std::vector<uint8_t> data(static_cast<size_t>(wanted));
+        size_t bytesRead = 0u;
+        if (!m_host.readHostFile(file.handle, file.position, data.data(), data.size(), bytesRead))
+            return kEinval;
+        if (bytesRead != 0u && !m_memory.writeRam(buffer, data.data(), bytesRead))
+            return kEinval;
+        file.position += bytesRead;
+        return static_cast<int32_t>(bytesRead);
+    }
+
+    int32_t IopIoman::lseek(uint32_t fd, int32_t offset, uint32_t whence)
+    {
+        const auto it = m_files.find(fd);
+        if (it == m_files.end())
+            return kEbadf;
+        File &file = it->second;
+        int64_t base = 0;
+        switch (whence)
+        {
+        case 0: // SEEK_SET
+            base = 0;
+            break;
+        case 1: // SEEK_CUR
+            base = static_cast<int64_t>(file.position);
+            break;
+        case 2: // SEEK_END
+            base = static_cast<int64_t>(file.size);
+            break;
+        default:
+            return kEinval;
+        }
+        const int64_t target = base + offset;
+        if (target < 0)
+            return kEinval;
+        file.position = static_cast<uint64_t>(target);
+        return static_cast<int32_t>(file.position);
     }
 
