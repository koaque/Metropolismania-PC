+namespace
+{
+    // PS2X_VIF_TRACE=1 logs VU1 microcode uploads (MPG) and program starts (MSCAL/MSCNT).
+    bool vifTraceEnabled()
+    {
+        static const bool enabled = []()
+        {
+            const char *value = std::getenv("PS2X_VIF_TRACE");
+            return value != nullptr && (value[0] == '1' || value[0] == '2');
+        }();
+        return enabled;
+    }
+
+    // PS2X_VIF_TRACE=2 additionally logs every VIF1 command (capped) to find stream desyncs.
+    bool vifTraceVerbose()
+    {
+        static const bool verbose = []()
+        {
+            const char *value = std::getenv("PS2X_VIF_TRACE");
+            return value != nullptr && value[0] == '2';
+        }();
+        return verbose;
+    }
+
+    bool vifTraceBudget()
+    {
+        static uint32_t s_lines = 0u;
+        return ++s_lines <= 6000u;
+    }
+
+    uint32_t readCodeWord(const uint8_t *code, uint32_t byteAddr, uint32_t size)
+    {
+        uint32_t value = 0u;
+        if (code && byteAddr + 4u <= size)
+            std::memcpy(&value, code + byteAddr, sizeof(value));
+        return value;
+    }
+}
