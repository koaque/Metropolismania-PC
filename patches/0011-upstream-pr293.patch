+                        "uint32_t flags = ((gt_mask & 0x1) << 0) | ((lt_mask & 0x1) << 1) | "
+                        "((gt_mask & 0x2) << 1) | ((lt_mask & 0x2) << 2) | "
+                        "((gt_mask & 0x4) << 2) | ((lt_mask & 0x4) << 3); "
                         "ctx->vu0_clip_flags = ((ctx->vu0_clip_flags << 6) | (flags & 0x3F)) & 0xFFFFFF; }}",
