From ran-j/PS2Recomp pull request #305: VU: don't hide a VI write in a taken branch's delay slot from the target (by @VariableDeclared)
https://github.com/ran-j/PS2Recomp/pull/305 (open, not yet merged upstream). GPL-3.0, same as PS2Recomp.

diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index 1b8dea8..e13a40c 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -1654,6 +1654,10 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
         if (m_cycle >= budgetEnd)
             break;
 
+        // A VI write in the delay slot of a taken branch is followed by the branch target, which
+        // starts a new block: a branch there reads the new value. Only a write by the instruction
+        // directly before a branch in program order is hidden from it.
+        const bool inTakenDelaySlot = m_state.branchPending && m_state.branchDelay == 0u;
         uint8_t writtenVi = 0u;
         int32_t oldVi = 0;
         for (uint32_t reg = 1; reg < 16u; ++reg)
@@ -1758,7 +1762,7 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
         }
 
         markPairWrites(decoded);
-        if (writtenVi != 0u && decoded.lowerUsage.delaysNextBranchRead)
+        if (writtenVi != 0u && decoded.lowerUsage.delaysNextBranchRead && !inTakenDelaySlot)
             recordViWriteForBranch(writtenVi, oldVi);
 
         m_state.vf[0][0] = 0.0f;
