 #include <cstring>
 #include <iostream>
 #include <sstream>
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <map>
+#include <sstream>
+
+namespace
+{
+    // PS2X_GS_STATS=1: every 2 s, log how many primitives were drawn, by type, target frame
+    // buffer and test state, plus the vertex coordinate range. Debug aid for missing geometry.
+    struct GsDrawStats
+    {
+        uint64_t draws = 0;
+        uint64_t byType[8] = {};
+        std::map<uint32_t, uint64_t> byFbp;
+        uint64_t zte = 0;
+        uint64_t ztst[4] = {};
+        uint64_t ate = 0;
+        uint64_t tme = 0;
+        float minX = 1e30f, maxX = -1e30f, minY = 1e30f, maxY = -1e30f;
+        std::chrono::steady_clock::time_point last = std::chrono::steady_clock::now();
+    };
+
+    bool gsStatsEnabled()
+    {
+        static const bool enabled = []()
+        {
+            const char *value = std::getenv("PS2X_GS_STATS");
+            return value != nullptr && value[0] == '1';
+        }();
+        return enabled;
+    }
+
+    void gsStatsRecord(const GSPrimitiveBatch &batch, uint32_t primType)
+    {
+        static GsDrawStats s;
+        ++s.draws;
+        ++s.byType[primType & 7u];
+        ++s.byFbp[batch.state.context.frame.fbp];
+        const uint64_t test = batch.state.context.test;
+        if (test & (1ull << 16))
+        {
+            ++s.zte;
+            ++s.ztst[(test >> 17) & 3u];
+        }
+        if (test & 1ull)
+            ++s.ate;
+        if (batch.state.prim.tme)
+            ++s.tme;
+        for (uint32_t i = 0; i < batch.vertexCount && i < batch.vertices.size(); ++i)
+        {
+            s.minX = std::min(s.minX, batch.vertices[i].x);
+            s.maxX = std::max(s.maxX, batch.vertices[i].x);
+            s.minY = std::min(s.minY, batch.vertices[i].y);
+            s.maxY = std::max(s.maxY, batch.vertices[i].y);
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now - s.last < std::chrono::seconds(2))
+            return;
+        std::ostringstream out;
+        out << "[gs:stats] draws=" << s.draws << " point/line/lstrip/tri/strip/fan/sprite="
+            << s.byType[0] << "/" << s.byType[1] << "/" << s.byType[2] << "/" << s.byType[3] << "/"
+            << s.byType[4] << "/" << s.byType[5] << "/" << s.byType[6] << " fbp{";
+        for (const auto &[fbp, count] : s.byFbp)
+            out << std::hex << "0x" << fbp << std::dec << ":" << count << " ";
+        out << "} zte=" << s.zte << " ztst(never/always/ge/gt)=" << s.ztst[0] << "/" << s.ztst[1] << "/"
+            << s.ztst[2] << "/" << s.ztst[3] << " ate=" << s.ate << " tme=" << s.tme
+            << " x=[" << s.minX << "," << s.maxX << "] y=[" << s.minY << "," << s.maxY << "]";
+        std::cerr << out.str() << std::endl;
+        s = GsDrawStats{};
+        s.last = now;
+    }
+}
 
