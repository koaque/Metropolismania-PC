+    // PS2X_DEINTERLACE=off (or =bob, see gs_cpu_backend.cpp) always presents single fields.
+    void weaveInterlacedFields(const GSPresentationRequest &request, PresentationFrame &frame)
+    {
+        static const bool enabled = []()
+        {
+            const char *value = std::getenv("PS2X_DEINTERLACE");
+            return value == nullptr || (std::strcmp(value, "off") != 0 && std::strcmp(value, "bob") != 0);
+        }();
+        struct State
+        {
+            std::vector<uint8_t> current; // newest field of the displayed buffer
+            std::vector<uint8_t> other;   // newest field of the buffer displayed before it
+            uint32_t fbp = 0xFFFFFFFFu;
+            uint32_t otherFbp = 0xFFFFFFFFu;
+            uint32_t width = 0u;
+            uint32_t height = 0u;
+            uint64_t tick = 0u;
+            uint32_t flips = 0u; // buffer changes since the display last held one buffer for 3 vsyncs
+            uint32_t holds = 0u; // vsyncs in a row on the same buffer
+        };
