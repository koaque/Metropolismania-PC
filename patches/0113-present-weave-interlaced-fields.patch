+
+        const bool fieldBuffers = (request.smode2 & 0x3ull) == 0x3ull; // INT=1, FFMD=1
+        const size_t stride = static_cast<size_t>(kHostFrameWidth) * 4u;
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!enabled || !fieldBuffers || frame.width > kHostFrameWidth || frame.height * 2u > kHostFrameHeight ||
+            frame.pixels.size() < stride * frame.height * 2u)
+        {
+            state.fbp = state.otherFbp = 0xFFFFFFFFu;
+            state.flips = state.holds = 0u;
+            return;
+        }
