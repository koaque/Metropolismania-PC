diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 0000000..1333d9a
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,902 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdlib>
+#include <cstring>
+
+// References: "SPU2 Overview" (register semantics) and psx-spx "Sound Processing Unit" (the PSX SPU
+// voice pipeline, which the SPU2 voices share: ADPCM decoding, Gaussian interpolation, envelopes,
+// noise). Register offsets follow PCSX2's SPU2 register map.
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr int16_t kGauss[512] = {
+#include "iop_spu2_gauss.inc"
+        };
+
+        constexpr int32_t kAdpcmPos[5] = {0, 60, 115, 98, 122};
+        constexpr int32_t kAdpcmNeg[5] = {0, 0, -52, -55, -60};
+
+        // Offsets inside a core's register block.
+        constexpr uint32_t kVoiceParams = 0x000u; // 24 voices x 16 bytes
+        constexpr uint32_t kPmon = 0x180u;
+        constexpr uint32_t kNon = 0x184u;
+        constexpr uint32_t kVmixL = 0x188u;
+        constexpr uint32_t kVmixEL = 0x18Cu;
+        constexpr uint32_t kVmixR = 0x190u;
+        constexpr uint32_t kVmixER = 0x194u;
+        constexpr uint32_t kMmix = 0x198u;
+        constexpr uint32_t kAttr = 0x19Au;
+        constexpr uint32_t kIrqa = 0x19Cu;
+        constexpr uint32_t kKon = 0x1A0u;
+        constexpr uint32_t kKoff = 0x1A4u;
+        constexpr uint32_t kTsa = 0x1A8u;
+        constexpr uint32_t kData = 0x1ACu;
+        constexpr uint32_t kAdmas = 0x1B0u;
+        constexpr uint32_t kVoiceAddrs = 0x1C0u; // 24 voices x 12 bytes: SSA, LSAX, NAX (high, low)
+        constexpr uint32_t kEsa = 0x2E0u;
+        constexpr uint32_t kEndx = 0x340u;
+        constexpr uint32_t kStatx = 0x344u;
+        // Per-core volume block (core 0 at 0x760, core 1 at 0x788), tagged with this bit below.
+        constexpr uint32_t kVolumeBlock = 0x1000u;
+        constexpr uint32_t kMvol = 0x00u, kEvol = 0x04u, kAvol = 0x08u, kBvol = 0x0Cu, kMvolx = 0x10u;
+        constexpr uint32_t kIrqInfo = 0x7C2u;
+
+        // Capture areas written every sample (offset by the output position).
+        constexpr uint32_t kCaptureVoice1[2] = {0x400u, 0xC00u};
+        constexpr uint32_t kCaptureVoice3[2] = {0x600u, 0xE00u};
+        constexpr uint32_t kCaptureMix[2] = {0x1000u, 0x1800u}; // dry L, dry R, wet L, wet R at +0x200 steps
+        constexpr uint32_t kCaptureCore0Out = 0x800u;           // core 0 output L, R at +0x200
+
+        uint32_t setHigh(uint32_t address, uint16_t value)
+        {
+            return ((static_cast<uint32_t>(value) << 16) | (address & 0xFFFFu)) & Spu2::kAddressMask;
+        }
+
+        uint32_t setLow(uint32_t address, uint16_t value)
+        {
+            return ((address & 0xFFFF0000u) | value) & Spu2::kAddressMask;
+        }
+
+        void setMaskHalf(uint32_t &mask, bool high, uint16_t value)
+        {
+            mask = high ? ((mask & 0xFFFFu) | ((static_cast<uint32_t>(value) & 0xFFu) << 16)) : ((mask & 0xFF0000u) | value);
+        }
+
+        uint16_t maskHalf(uint32_t mask, bool high)
+        {
+            return static_cast<uint16_t>(high ? (mask >> 16) & 0xFFu : mask & 0xFFFFu);
+        }
+    }
+
+    Spu2::Spu2()
+        : m_ram(kRamHalfwords), m_ring(kRingFrames * 2u)
+    {
+        if (const char *path = std::getenv("PS2X_SPU2_WAV"); path != nullptr && path[0] != '\0')
+        {
+            m_wav = std::fopen(path, "wb");
+            if (m_wav)
+                writeWavHeader();
+        }
+        reset();
+    }
+
+    Spu2::~Spu2()
+    {
+        if (m_wav)
+        {
+            writeWavHeader();
+            std::fclose(m_wav);
+        }
+    }
+
+    void Spu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        for (Core &core : m_cores)
+        {
+            core = Core{};
+            core.endx = 0xFFFFFFu; // PCSX2: confirmed on hardware
+        }
+        m_regs.fill(0u);
+        m_irqInfo = 0;
+        m_irqRaised = false;
+        m_outPos = 0;
+        m_haveCycle = false;
+        m_cycle = 0;
+    }
+
+    int32_t Spu2::clamp16(int32_t value) noexcept
+    {
+        return std::clamp(value, -0x8000, 0x7FFF);
+    }
+
+    int32_t Spu2::directVolume(uint16_t value) noexcept
+    {
+        // Bits 14-0 hold volume/2 as a signed 15-bit value.
+        return static_cast<int16_t>(static_cast<uint16_t>(value << 1));
+    }
+
+    // psx-spx "Envelope Operation depending on Shift/Step/Mode/Direction", run once per sample.
+    void Spu2::tickEnvelope(Envelope &envelope, uint32_t rate, uint32_t rateMask, bool decreasing, bool exponential, bool phaseNegative) noexcept
+    {
+        const int32_t shift = static_cast<int32_t>(rate >> 2);
+        const int32_t stepValue = static_cast<int32_t>(rate & 3u);
+        int32_t step = 7 - stepValue;
+        if (decreasing != phaseNegative)
+            step = ~step;
+        step *= 1 << std::max(0, 11 - shift);
+        uint32_t increment = 0x8000u >> std::max(0, shift - 11);
+        const int32_t level = envelope.level;
+        if (exponential && !decreasing && level > 0x6000)
+        {
+            if (shift < 10)
+                step >>= 2;
+            else if (shift >= 11)
+                increment >>= 2;
+            else
+            {
+                step >>= 1;
+                increment >>= 1;
+            }
+        }
+        else if (exponential && decreasing)
+        {
+            step = (step * level) >> 15;
+        }
+        // A rate with every bit set never steps (0x7F, or 0x1F << 2 for release).
+        if ((rate & rateMask) != rateMask)
+            increment = std::max(increment, 1u);
+
+        envelope.counter += increment;
+        if ((envelope.counter & 0x8000u) == 0u)
+            return;
+        envelope.counter = 0;
+
+        int32_t next = level + step;
+        if (!decreasing)
+            next = std::clamp(next, -0x8000, 0x7FFF);
+        else if (phaseNegative)
+            next = std::clamp(next, -0x8000, 0);
+        else
+            next = std::max(next, 0);
+        envelope.level = next;
+    }
+
+    void Spu2::tickSweep(Envelope &envelope, uint16_t reg) noexcept
+    {
+        if ((reg & 0x8000u) == 0u)
+        {
+            envelope.level = directVolume(reg);
+            return;
+        }
+        tickEnvelope(envelope, reg & 0x7Fu, 0x7Fu, (reg & 0x2000u) != 0u, (reg & 0x4000u) != 0u, (reg & 0x1000u) != 0u);
+    }
+
+    uint16_t Spu2::read16(uint32_t phys)
+    {
+        const uint32_t offset = (phys - kRegBase) & 0x7FEu;
+        if (offset < 0x760u)
+            return readCoreRegister(offset >= 0x400u ? 1 : 0, offset & 0x3FFu);
+        if (offset < 0x7B0u)
+        {
+            const int core = offset >= 0x788u ? 1 : 0;
+            const uint16_t live = readCoreRegister(core, kVolumeBlock | (offset - (core ? 0x788u : 0x760u)));
+            return live;
+        }
+        if (offset == kIrqInfo)
+            return m_irqInfo;
+        return m_regs[offset / 2u];
+    }
+
+    void Spu2::write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t offset = (phys - kRegBase) & 0x7FEu;
+        m_regs[offset / 2u] = value;
+        if (offset < 0x760u)
+        {
+            writeCoreRegister(offset >= 0x400u ? 1 : 0, offset & 0x3FFu, value);
+            return;
+        }
+        if (offset < 0x7B0u)
+        {
+            const int core = offset >= 0x788u ? 1 : 0;
+            writeCoreRegister(core, kVolumeBlock | (offset - (core ? 0x788u : 0x760u)), value);
+            return;
+        }
+        if (offset == kIrqInfo)
+            m_irqInfo = value;
+    }
+
+    uint16_t Spu2::readCoreRegister(int coreIndex, uint32_t offset)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        const uint32_t global = coreIndex == 0 ? offset : (offset & kVolumeBlock ? 0x788u + (offset & 0xFFFu) : 0x400u + offset);
+        const uint16_t raw = m_regs[(global & 0x7FEu) / 2u];
+
+        if (offset & kVolumeBlock)
+        {
+            switch (offset & 0xFFFu)
+            {
+            case kMvolx:
+                return static_cast<uint16_t>(core.masterL.level);
+            case kMvolx + 2u:
+                return static_cast<uint16_t>(core.masterR.level);
+            default:
+                return raw;
+            }
+        }
+        if (offset < kPmon)
+        {
+            const Voice &voice = core.voices[offset >> 4];
+            switch (offset & 0xFu)
+            {
+            case 0xAu:
+                return static_cast<uint16_t>(voice.adsr.level);
+            case 0xCu:
+                return static_cast<uint16_t>(voice.sweepL.level);
+            case 0xEu:
+                return static_cast<uint16_t>(voice.sweepR.level);
+            default:
+                return raw;
+            }
+        }
+        if (offset >= kVoiceAddrs && offset < kVoiceAddrs + 24u * 12u)
+        {
+            const uint32_t rel = offset - kVoiceAddrs;
+            const Voice &voice = core.voices[rel / 12u];
+            uint32_t address = 0;
+            switch ((rel % 12u) / 4u)
+            {
+            case 0:
+                address = voice.ssa;
+                break;
+            case 1:
+                address = voice.lsax;
+                break;
+            default:
+                address = voice.needBlock ? voice.blockAddress
+                                          : (voice.blockAddress + 1u + ((voice.counter >> 12) >> 2)) & kAddressMask;
+                break;
+            }
+            return static_cast<uint16_t>((rel & 2u) ? address & 0xFFFFu : address >> 16);
+        }
+        switch (offset)
+        {
+        case kPmon:
+        case kPmon + 2u:
+            return maskHalf(core.pmon, offset & 2u);
+        case kNon:
+        case kNon + 2u:
+            return maskHalf(core.non, offset & 2u);
+        case kVmixL:
+        case kVmixL + 2u:
+            return maskHalf(core.vmixL, offset & 2u);
+        case kVmixEL:
+        case kVmixEL + 2u:
+            return maskHalf(core.vmixEL, offset & 2u);
+        case kVmixR:
+        case kVmixR + 2u:
+            return maskHalf(core.vmixR, offset & 2u);
+        case kVmixER:
+        case kVmixER + 2u:
+            return maskHalf(core.vmixER, offset & 2u);
+        case kMmix:
+            return core.mmix;
+        case kAttr:
+            return core.attr;
+        case kIrqa:
+            return static_cast<uint16_t>(core.irqa >> 16);
+        case kIrqa + 2u:
+            return static_cast<uint16_t>(core.irqa & 0xFFFFu);
+        case kTsa:
+            return static_cast<uint16_t>(core.tsa >> 16);
+        case kTsa + 2u:
+            return static_cast<uint16_t>(core.tsa & 0xFFFFu);
+        case kAdmas:
+            return core.admas;
+        case kEsa:
+            return static_cast<uint16_t>(core.esa >> 16);
+        case kEsa + 2u:
+            return static_cast<uint16_t>(core.esa & 0xFFFFu);
+        case kEndx:
+        case kEndx + 2u:
+            return maskHalf(core.endx, offset & 2u);
+        case kStatx:
+            return core.statx;
+        default:
+            return raw;
+        }
+    }
+
+    void Spu2::writeCoreRegister(int coreIndex, uint32_t offset, uint16_t value)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        if (offset & kVolumeBlock)
+        {
+            switch (offset & 0xFFFu)
+            {
+            case kMvol:
+                core.mvolL = value;
+                if ((value & 0x8000u) == 0u)
+                    core.masterL = {directVolume(value), 0u};
+                break;
+            case kMvol + 2u:
+                core.mvolR = value;
+                if ((value & 0x8000u) == 0u)
+                    core.masterR = {directVolume(value), 0u};
+                break;
+            case kEvol:
+                core.evolL = static_cast<int16_t>(value);
+                break;
+            case kEvol + 2u:
+                core.evolR = static_cast<int16_t>(value);
+                break;
+            case kAvol:
+                core.avolL = static_cast<int16_t>(value);
+                break;
+            case kAvol + 2u:
+                core.avolR = static_cast<int16_t>(value);
+                break;
+            case kBvol:
+                core.bvolL = static_cast<int16_t>(value);
+                break;
+            case kBvol + 2u:
+                core.bvolR = static_cast<int16_t>(value);
+                break;
+            default:
+                break; // reverb coefficients: stored raw
+            }
+            return;
+        }
+        if (offset < kPmon)
+        {
+            Voice &voice = core.voices[offset >> 4];
+            switch (offset & 0xFu)
+            {
+            case 0x0u:
+                voice.volL = value;
+                if ((value & 0x8000u) == 0u)
+                    voice.sweepL = {directVolume(value), 0u};
+                break;
+            case 0x2u:
+                voice.volR = value;
+                if ((value & 0x8000u) == 0u)
+                    voice.sweepR = {directVolume(value), 0u};
+                break;
+            case 0x4u:
+                voice.pitch = value;
+                break;
+            case 0x6u:
+                voice.adsr1 = value;
+                break;
+            case 0x8u:
+                voice.adsr2 = value;
+                break;
+            case 0xAu:
+                voice.adsr.level = static_cast<int16_t>(value);
+                break;
+            default:
+                break; // VOLXL/VOLXR are read-only
+            }
+            return;
+        }
+        if (offset >= kVoiceAddrs && offset < kVoiceAddrs + 24u * 12u)
+        {
+            const uint32_t rel = offset - kVoiceAddrs;
+            Voice &voice = core.voices[rel / 12u];
+            const bool low = (rel & 2u) != 0u;
+            switch ((rel % 12u) / 4u)
+            {
+            case 0:
+                voice.ssa = low ? setLow(voice.ssa, value) : setHigh(voice.ssa, value);
+                break;
+            case 1:
+                voice.lsax = low ? setLow(voice.lsax, value) : setHigh(voice.lsax, value);
+                voice.loopAddressSet = true;
+                break;
+            default:
+                voice.blockAddress = low ? setLow(voice.blockAddress, value) : setHigh(voice.blockAddress, value);
+                voice.needBlock = true;
+                break;
+            }
+            return;
+        }
+        switch (offset)
+        {
+        case kPmon:
+        case kPmon + 2u:
+            setMaskHalf(core.pmon, offset & 2u, value);
+            break;
+        case kNon:
+        case kNon + 2u:
+            setMaskHalf(core.non, offset & 2u, value);
+            break;
+        case kVmixL:
+        case kVmixL + 2u:
+            setMaskHalf(core.vmixL, offset & 2u, value);
+            break;
+        case kVmixEL:
+        case kVmixEL + 2u:
+            setMaskHalf(core.vmixEL, offset & 2u, value);
+            break;
+        case kVmixR:
+        case kVmixR + 2u:
+            setMaskHalf(core.vmixR, offset & 2u, value);
+            break;
+        case kVmixER:
+        case kVmixER + 2u:
+            setMaskHalf(core.vmixER, offset & 2u, value);
+            break;
+        case kMmix:
+            core.mmix = value;
+            break;
+        case kAttr:
+        {
+            const uint32_t oldDmaMode = (core.attr >> 4) & 3u;
+            const uint32_t dmaMode = (value >> 4) & 3u;
+            core.attr = value;
+            if (dmaMode == 0u && (core.statx & 0x400u) == 0u)
+                core.statx = static_cast<uint16_t>(core.statx & ~0x80u);
+            else if (oldDmaMode == 0u && dmaMode != 0u)
+                core.statx = static_cast<uint16_t>(core.statx | 0x80u);
+            if ((value & 0x40u) == 0u)
+                m_irqInfo = static_cast<uint16_t>(m_irqInfo & ~(4u << coreIndex)); // IRQ acknowledge
+            break;
+        }
+        case kIrqa:
+            core.irqa = setHigh(core.irqa, value);
+            break;
+        case kIrqa + 2u:
+            core.irqa = setLow(core.irqa, value);
+            break;
+        case kKon:
+            keyOn(coreIndex, value);
+            break;
+        case kKon + 2u:
+            keyOn(coreIndex, (static_cast<uint32_t>(value) & 0xFFu) << 16);
+            break;
+        case kKoff:
+            keyOff(coreIndex, value);
+            break;
+        case kKoff + 2u:
+            keyOff(coreIndex, (static_cast<uint32_t>(value) & 0xFFu) << 16);
+            break;
+        case kTsa:
+            core.tsa = setHigh(core.tsa, value);
+            break;
+        case kTsa + 2u:
+            core.tsa = setLow(core.tsa, value);
+            break;
+        case kData: // manual transfer: one halfword at the transfer address
+            checkIrq(core.tsa);
+            m_ram[core.tsa] = value;
+            core.tsa = (core.tsa + 1u) & kAddressMask;
+            break;
+        case kAdmas:
+            core.admas = value;
+            break;
+        case kEsa:
+            core.esa = setHigh(core.esa, value);
+            break;
+        case kEsa + 2u:
+            core.esa = setLow(core.esa, value);
+            break;
+        case kEndx: // writing clears that half (PCSX2)
+            core.endx &= 0xFF0000u;
+            break;
+        case kEndx + 2u:
+            core.endx &= 0x00FFFFu;
+            break;
+        default:
+            break; // reverb addresses, KON/KOFF read-back and the rest: stored raw
+        }
+    }
+
+    void Spu2::keyOn(int coreIndex, uint32_t mask)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        for (uint32_t live = mask & 0xFFFFFFu; live != 0u; live &= live - 1u)
+        {
+            const uint32_t index = static_cast<uint32_t>(std::countr_zero(live));
+            Voice &voice = core.voices[index];
+            voice.blockAddress = voice.ssa & ~7u;
+            voice.needBlock = true;
+            voice.loopAddressSet = false;
+            voice.counter = 0;
+            voice.adpcmPrev[0] = voice.adpcmPrev[1] = 0;
+            std::fill(std::begin(voice.samples), std::end(voice.samples), int16_t{0});
+            voice.adsr = {};
+            voice.phase = Phase::Attack;
+            core.endx &= ~(1u << index);
+        }
+    }
+
+    void Spu2::keyOff(int coreIndex, uint32_t mask)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        for (uint32_t live = mask & 0xFFFFFFu; live != 0u; live &= live - 1u)
+        {
+            Voice &voice = core.voices[static_cast<size_t>(std::countr_zero(live))];
+            if (voice.phase != Phase::Off && voice.phase != Phase::Release)
+            {
+                voice.phase = Phase::Release;
+                voice.adsr.counter = 0;
+            }
+        }
+    }
+
+    void Spu2::raiseIrq(int coreIndex) noexcept
+    {
+        const uint16_t bit = static_cast<uint16_t>(4u << coreIndex);
+        if ((m_cores[static_cast<size_t>(coreIndex)].attr & 0x40u) == 0u || (m_irqInfo & bit) != 0u)
+            return;
+        m_irqInfo = static_cast<uint16_t>(m_irqInfo | bit);
+        m_irqRaised = true;
+    }
+
+    void Spu2::checkIrq(uint32_t address) noexcept
+    {
+        for (int core = 0; core < 2; ++core)
+        {
+            if (m_cores[static_cast<size_t>(core)].irqa == (address & kAddressMask))
+                raiseIrq(core);
+        }
+    }
+
+    void Spu2::checkIrqRange(uint32_t begin, uint32_t count) noexcept
+    {
+        for (int core = 0; core < 2; ++core)
+        {
+            if (((m_cores[static_cast<size_t>(core)].irqa - begin) & kAddressMask) < count)
+                raiseIrq(core);
+        }
+    }
+
+    bool Spu2::takeIrq() noexcept
+    {
+        const bool raised = m_irqRaised;
+        m_irqRaised = false;
+        return raised;
+    }
+
+    void Spu2::dmaWrite(int coreIndex, const uint16_t *data, uint32_t halfwords)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        core.statx = static_cast<uint16_t>((core.statx & ~0x80u) | 0x400u);
+        if ((core.admas & static_cast<uint16_t>(coreIndex + 1)) != 0u)
+        {
+            // AutoDMA (streamed PCM input) is not mixed yet; keep the data in the input area.
+            const uint32_t base = 0x2000u + static_cast<uint32_t>(coreIndex) * 0x400u;
+            for (uint32_t i = 0; i < halfwords; ++i)
+                m_ram[base + (i & 0x3FFu)] = data[i];
+            return;
+        }
+        checkIrqRange(core.tsa, halfwords);
+        for (uint32_t i = 0; i < halfwords; ++i)
+            m_ram[(core.tsa + i) & kAddressMask] = data[i];
+        core.tsa = (core.tsa + halfwords) & kAddressMask;
+    }
+
+    void Spu2::dmaRead(int coreIndex, uint16_t *data, uint32_t halfwords)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        core.statx = static_cast<uint16_t>((core.statx & ~0x80u) | 0x400u);
+        checkIrqRange(core.tsa, halfwords);
+        for (uint32_t i = 0; i < halfwords; ++i)
+            data[i] = m_ram[(core.tsa + i) & kAddressMask];
+        core.tsa = (core.tsa + halfwords) & kAddressMask;
+    }
+
+    void Spu2::dmaFinished(int coreIndex)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        core.statx = static_cast<uint16_t>((core.statx & ~0x400u) | 0x80u);
+    }
+
+    void Spu2::decodeBlock(Voice &voice) noexcept
+    {
+        const uint32_t address = voice.blockAddress & kAddressMask;
+        checkIrqRange(address, 8u);
+        const uint16_t header = m_ram[address];
+        uint32_t shift = header & 0xFu;
+        uint32_t filter = (header >> 4) & 0x7u;
+        voice.blockFlags = static_cast<uint8_t>(header >> 8);
+        if ((voice.blockFlags & 4u) != 0u && !voice.loopAddressSet)
+            voice.lsax = address;
+        if (shift > 12u)
+            shift = 9u;
+        if (filter > 4u)
+            filter = 4u;
+        const int32_t pos = kAdpcmPos[filter];
+        const int32_t neg = kAdpcmNeg[filter];
+        int32_t prev0 = voice.adpcmPrev[0];
+        int32_t prev1 = voice.adpcmPrev[1];
+        for (uint32_t i = 0; i < 28u; ++i)
+        {
+            const uint16_t word = m_ram[(address + 1u + (i >> 2)) & kAddressMask];
+            const uint32_t nibble = (word >> ((i & 3u) * 4u)) & 0xFu;
+            int32_t sample = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12)) >> shift;
+            sample += (prev0 * pos + prev1 * neg + 32) >> 6;
+            sample = clamp16(sample);
+            voice.samples[3u + i] = static_cast<int16_t>(sample);
+            prev1 = prev0;
+            prev0 = sample;
+        }
+        voice.adpcmPrev[0] = static_cast<int16_t>(prev0);
+        voice.adpcmPrev[1] = static_cast<int16_t>(prev1);
+        voice.needBlock = false;
+    }
+
+    void Spu2::tickAdsr(Voice &voice) noexcept
+    {
+        switch (voice.phase)
+        {
+        case Phase::Attack:
+            tickEnvelope(voice.adsr, (voice.adsr1 >> 8) & 0x7Fu, 0x7Fu, false, (voice.adsr1 & 0x8000u) != 0u, false);
+            if (voice.adsr.level >= 0x7FFF)
+            {
+                voice.phase = Phase::Decay;
+                voice.adsr.counter = 0;
+            }
+            break;
+        case Phase::Decay:
+            tickEnvelope(voice.adsr, ((voice.adsr1 >> 4) & 0xFu) << 2, 0x7Cu, true, true, false);
+            if (voice.adsr.level <= static_cast<int32_t>(((voice.adsr1 & 0xFu) + 1u) * 0x800u))
+            {
+                voice.phase = Phase::Sustain;
+                voice.adsr.counter = 0;
+            }
+            break;
+        case Phase::Sustain:
+            tickEnvelope(voice.adsr, (voice.adsr2 >> 6) & 0x7Fu, 0x7Fu, (voice.adsr2 & 0x4000u) != 0u, (voice.adsr2 & 0x8000u) != 0u, false);
+            break;
+        case Phase::Release:
+            tickEnvelope(voice.adsr, (voice.adsr2 & 0x1Fu) << 2, 0x7Cu, true, (voice.adsr2 & 0x20u) != 0u, false);
+            if (voice.adsr.level <= 0)
+            {
+                voice.adsr.level = 0;
+                voice.phase = Phase::Off;
+            }
+            break;
+        case Phase::Off:
+            break;
+        }
+    }
+
+    void Spu2::tickNoise(Core &core) noexcept
+    {
+        const uint32_t clock = (core.attr >> 8) & 0x3Fu;
+        const int32_t shift = static_cast<int32_t>(clock >> 2);
+        const int32_t step = static_cast<int32_t>(clock & 3u) + 4;
+        core.noiseTimer -= step;
+        const int32_t level = core.noiseLevel;
+        const int32_t parity = ((level >> 15) ^ (level >> 12) ^ (level >> 11) ^ (level >> 10) ^ 1) & 1;
+        if (core.noiseTimer < 0)
+        {
+            core.noiseLevel = ((level << 1) | parity) & 0xFFFF;
+            core.noiseTimer += 0x20000 >> shift;
+            if (core.noiseTimer < 0)
+                core.noiseTimer += 0x20000 >> shift;
+        }
+    }
+
+    Spu2::StereoSample Spu2::mixCore(int coreIndex, const StereoSample &external)
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        int32_t previousOut[24];
+        for (size_t v = 0; v < 24u; ++v)
+            previousOut[v] = core.voices[v].outx;
+
+        int32_t dryL = 0, dryR = 0, wetL = 0, wetR = 0;
+        for (uint32_t v = 0; v < 24u; ++v)
+        {
+            Voice &voice = core.voices[v];
+            if (voice.phase == Phase::Off)
+            {
+                voice.outx = 0;
+                continue;
+            }
+            if (voice.needBlock)
+                decodeBlock(voice);
+
+            int32_t sample = 0;
+            if ((core.non >> v) & 1u)
+            {
+                sample = static_cast<int16_t>(static_cast<uint16_t>(core.noiseLevel));
+            }
+            else
+            {
+                const uint32_t s = voice.counter >> 12;
+                const uint32_t i = (voice.counter >> 4) & 0xFFu;
+                sample = ((kGauss[0xFFu - i] * voice.samples[s]) >> 15) +
+                         ((kGauss[0x1FFu - i] * voice.samples[s + 1u]) >> 15) +
+                         ((kGauss[0x100u + i] * voice.samples[s + 2u]) >> 15) +
+                         ((kGauss[i] * voice.samples[s + 3u]) >> 15);
+            }
+
+            tickAdsr(voice);
+            const int32_t out = (sample * voice.adsr.level) >> 15;
+            voice.outx = out;
+            tickSweep(voice.sweepL, voice.volL);
+            tickSweep(voice.sweepR, voice.volR);
+            const int32_t left = (out * voice.sweepL.level) >> 15;
+            const int32_t right = (out * voice.sweepR.level) >> 15;
+            const uint32_t bit = 1u << v;
+            if (core.vmixL & bit)
+                dryL += left;
+            if (core.vmixR & bit)
+                dryR += right;
+            if (core.vmixEL & bit)
+                wetL += left;
+            if (core.vmixER & bit)
+                wetR += right;
+
+            // Pitch counter (psx-spx "Pitch Counter"), modulated by the previous voice's output.
+            int32_t step = voice.pitch;
+            if (v > 0u && ((core.pmon >> v) & 1u))
+            {
+                const int32_t factor = previousOut[v - 1u] + 0x8000;
+                step = ((static_cast<int32_t>(static_cast<int16_t>(voice.pitch)) * factor) >> 15) & 0xFFFF;
+            }
+            if (step > 0x3FFF)
+                step = 0x4000;
+            voice.counter += static_cast<uint32_t>(step);
+            if ((voice.counter >> 12) >= 28u)
+            {
+                voice.counter -= 28u << 12;
+                std::memcpy(voice.samples, voice.samples + 28, 3u * sizeof(int16_t));
+                if ((voice.blockFlags & 1u) != 0u)
+                {
+                    core.endx |= bit;
+                    voice.blockAddress = voice.lsax & ~7u;
+                    if ((voice.blockFlags & 2u) == 0u && !((core.non >> v) & 1u))
+                    {
+                        voice.phase = Phase::Release;
+                        voice.adsr.level = 0;
+                    }
+                }
+                else
+                {
+                    voice.blockAddress = (voice.blockAddress + 8u) & kAddressMask;
+                }
+                voice.needBlock = true;
+            }
+        }
+
+        dryL = clamp16(dryL);
+        dryR = clamp16(dryR);
+        wetL = clamp16(wetL);
+        wetR = clamp16(wetR);
+        const uint32_t mix = kCaptureMix[coreIndex] + m_outPos;
+        m_ram[mix] = static_cast<uint16_t>(dryL);
+        m_ram[mix + 0x200u] = static_cast<uint16_t>(dryR);
+        m_ram[mix + 0x400u] = static_cast<uint16_t>(wetL);
+        m_ram[mix + 0x600u] = static_cast<uint16_t>(wetR);
+        m_ram[kCaptureVoice1[coreIndex] + m_outPos] = static_cast<uint16_t>(clamp16(core.voices[1].outx));
+        m_ram[kCaptureVoice3[coreIndex] + m_outPos] = static_cast<uint16_t>(clamp16(core.voices[3].outx));
+
+        // MMIX gates (PCSX2): bits 0-3 external input (core 1 only), 4-7 sound data input, 8-11 voices.
+        const uint32_t gates = core.mmix & (coreIndex == 0 ? 0xFF0u : 0xFFFu);
+        StereoSample dry;
+        dry.left = ((gates & 0x800u) ? dryL : 0) + ((gates & 0x008u) ? external.left : 0);
+        dry.right = ((gates & 0x400u) ? dryR : 0) + ((gates & 0x004u) ? external.right : 0);
+        // Reverb is not emulated yet, so the wet (effect) path is not heard.
+        return dry;
+    }
+
+    void Spu2::tickSample()
+    {
+        tickNoise(m_cores[0]);
+        tickNoise(m_cores[1]);
+
+        Core &core0 = m_cores[0];
+        Core &core1 = m_cores[1];
+        const StereoSample out0 = mixCore(0, StereoSample{});
+        tickSweep(core0.masterL, core0.mvolL);
+        tickSweep(core0.masterR, core0.mvolR);
+        StereoSample external{clamp16((out0.left * core0.masterL.level) >> 15), clamp16((out0.right * core0.masterR.level) >> 15)};
+        m_ram[kCaptureCore0Out + m_outPos] = static_cast<uint16_t>(external.left);
+        m_ram[kCaptureCore0Out + 0x200u + m_outPos] = static_cast<uint16_t>(external.right);
+        external.left = (external.left * core1.avolL) >> 15;
+        external.right = (external.right * core1.avolR) >> 15;
+
+        const StereoSample out1 = mixCore(1, external);
+        tickSweep(core1.masterL, core1.mvolL);
+        tickSweep(core1.masterR, core1.mvolR);
+        const int32_t left = clamp16((out1.left * core1.masterL.level) >> 15);
+        const int32_t right = clamp16((out1.right * core1.masterR.level) >> 15);
+
+        // The capture areas (0x400-0x1FFF) are written at the output position every sample.
+        for (int core = 0; core < 2; ++core)
+        {
+            const uint32_t irqa = m_cores[static_cast<size_t>(core)].irqa;
+            if (irqa >= 0x400u && irqa < 0x2000u && (irqa & 0x1FFu) == m_outPos)
+                raiseIrq(core);
+        }
+        m_outPos = (m_outPos + 1u) & 0x1FFu;
+
+        pushOutput(static_cast<int16_t>(left), static_cast<int16_t>(right));
+    }
+
+    void Spu2::advanceTo(uint64_t iopCycle)
+    {
+        if (!m_haveCycle)
+        {
+            m_cycle = iopCycle;
+            m_haveCycle = true;
+            return;
+        }
+        // After a long stall, do not try to catch up more than a quarter second.
+        constexpr uint64_t kMaxBacklog = 12000u * kCyclesPerSample;
+        if (iopCycle > m_cycle + kMaxBacklog)
+            m_cycle = iopCycle - kMaxBacklog;
+        while (m_cycle + kCyclesPerSample <= iopCycle)
+        {
+            tickSample();
+            m_cycle += kCyclesPerSample;
+        }
+    }
+
+    void Spu2::pushOutput(int16_t left, int16_t right) noexcept
+    {
+        if (m_wav)
+        {
+            const int16_t frame[2] = {left, right};
+            std::fwrite(frame, sizeof(frame), 1, m_wav);
+            if ((++m_wavFrames % 48000u) == 0u)
+                writeWavHeader(); // keep the file playable if the process is killed
+        }
+        const uint32_t write = m_ringWrite.load(std::memory_order_relaxed);
+        const uint32_t read = m_ringRead.load(std::memory_order_acquire);
+        if (write - read >= kRingFrames)
+            return; // the host is not consuming (or is slower than the SPU2): drop
+        const uint32_t slot = (write % kRingFrames) * 2u;
+        m_ring[slot] = left;
+        m_ring[slot + 1u] = right;
+        m_ringWrite.store(write + 1u, std::memory_order_release);
+    }
+
+    size_t Spu2::pullAudio(int16_t *stereo, size_t frames) noexcept
+    {
+        const uint32_t read = m_ringRead.load(std::memory_order_relaxed);
+        const uint32_t write = m_ringWrite.load(std::memory_order_acquire);
+        const size_t available = std::min<size_t>(write - read, frames);
+        for (size_t i = 0; i < available; ++i)
+        {
+            const uint32_t slot = ((read + static_cast<uint32_t>(i)) % kRingFrames) * 2u;
+            stereo[i * 2u] = m_ring[slot];
+            stereo[i * 2u + 1u] = m_ring[slot + 1u];
+        }
+        std::fill(stereo + available * 2u, stereo + frames * 2u, int16_t{0});
+        m_ringRead.store(read + static_cast<uint32_t>(available), std::memory_order_release);
+        return available;
+    }
+
+    void Spu2::writeWavHeader()
+    {
+        const uint32_t dataBytes = m_wavFrames * 4u;
+        const long position = std::ftell(m_wav);
+        std::fseek(m_wav, 0, SEEK_SET);
+        const auto u32 = [this](uint32_t value) { std::fwrite(&value, 4, 1, m_wav); };
+        const auto u16 = [this](uint16_t value) { std::fwrite(&value, 2, 1, m_wav); };
+        std::fwrite("RIFF", 4, 1, m_wav);
+        u32(36u + dataBytes);
+        std::fwrite("WAVEfmt ", 8, 1, m_wav);
+        u32(16u);
+        u16(1u);      // PCM
+        u16(2u);      // stereo
+        u32(48000u);  // sample rate
+        u32(192000u); // byte rate
+        u16(4u);      // block align
+        u16(16u);     // bits per sample
+        std::fwrite("data", 4, 1, m_wav);
+        u32(dataBytes);
+        if (position > 44)
+            std::fseek(m_wav, position, SEEK_SET);
+        std::fflush(m_wav);
+    }
+}
