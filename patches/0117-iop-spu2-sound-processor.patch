+#if !defined(PLATFORM_VITA)
+namespace
+{
+    // SPU2 output (IOP emulator, 48 kHz stereo) played through a raylib audio stream whose callback
+    // pulls from the SPU2's ring buffer. PS2X_SPU2=0 leaves it off.
+    ps2x::iop::IopSubsystem *s_spu2Source = nullptr;
+    AudioStream s_spu2Stream{};
+    bool s_spu2StreamLoaded = false;
+
+    void spu2StreamCallback(void *buffer, unsigned int frames)
+    {
+        int16_t *out = static_cast<int16_t *>(buffer);
+        size_t pulled = 0;
+        if (s_spu2Source)
+            pulled = s_spu2Source->pullAudio(out, frames);
+        else
+            std::memset(out, 0, static_cast<size_t>(frames) * 4u);
+        static bool s_announced = false;
+        if (pulled != 0u && !s_announced)
+        {
+            s_announced = true;
+            std::cerr << "[spu2] host audio stream is playing SPU2 output" << std::endl;
+        }
+    }
+
+    void startSpu2Stream(ps2x::iop::IopSubsystem *source)
+    {
+        const char *flag = std::getenv("PS2X_SPU2");
+        if (s_spu2StreamLoaded || !source || !IsAudioDeviceReady() || (flag && flag[0] == '0'))
+            return;
+        s_spu2Source = source;
+        SetAudioStreamBufferSizeDefault(1024);
+        s_spu2Stream = LoadAudioStream(48000, 16, 2);
+        SetAudioStreamCallback(s_spu2Stream, spu2StreamCallback);
+        PlayAudioStream(s_spu2Stream);
+        s_spu2StreamLoaded = true;
+    }
+
+    void stopSpu2Stream()
+    {
+        if (!s_spu2StreamLoaded)
+            return;
+        StopAudioStream(s_spu2Stream);
+        UnloadAudioStream(s_spu2Stream); // waits for the mixer, so the callback is no longer running
+        s_spu2StreamLoaded = false;
+        s_spu2Source = nullptr;
+    }
+}
+#endif
