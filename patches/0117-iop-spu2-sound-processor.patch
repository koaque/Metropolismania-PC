@@ -0,0 +1,144 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // SPU2 sound processor: two cores of 24 ADPCM voices sharing 2 MB of sound RAM, producing one
+    // stereo sample every 768 IOP cycles (48 kHz). Registers are 16 bits wide at
+    // 0x1F900000-0x1F9007FF (core 1 at +0x400 for the per-core block, its volumes at 0x788).
+    //
+    // Implemented: voice playback (SPU-ADPCM decoding with loop flags, 4-point Gaussian
+    // interpolation, pitch and pitch modulation, noise, ADSR envelope, volume sweeps), the voice
+    // mixer and MMIX gates, core 0 feeding core 1, master volume, capture areas, manual and DMA
+    // transfers, and the IRQA interrupt. Not yet: reverb, AutoDMA (streamed PCM) input.
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t kRegBase = 0x1F900000u;
+        static constexpr uint32_t kRegSize = 0x800u;
+        static constexpr uint32_t kRamHalfwords = 1u << 20; // 2 MB
+        static constexpr uint32_t kAddressMask = kRamHalfwords - 1u;
+        static constexpr uint32_t kCyclesPerSample = 768u;  // 36.864 MHz / 48 kHz
+
+        Spu2();
+        ~Spu2();
+        Spu2(const Spu2 &) = delete;
+        Spu2 &operator=(const Spu2 &) = delete;
+
+        void reset();
+
+        [[nodiscard]] static bool isRegister(uint32_t phys) noexcept { return phys >= kRegBase && phys < kRegBase + kRegSize; }
+        [[nodiscard]] uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) and 7 (core 1). Transfers complete immediately; the caller
+        // raises the DMA interrupt and then calls dmaFinished.
+        void dmaWrite(int core, const uint16_t *data, uint32_t halfwords);
+        void dmaRead(int core, uint16_t *data, uint32_t halfwords);
+        void dmaFinished(int core);
+
+        // Produces samples up to the given IOP cycle count.
+        void advanceTo(uint64_t iopCycle);
+        // True once for every SPU2 interrupt (IOP IRQ 9) raised since the last call.
+        [[nodiscard]] bool takeIrq() noexcept;
+
+        // Host audio thread: copies up to `frames` interleaved stereo samples, pads the rest with
+        // silence, and returns how many came from the SPU2.
+        size_t pullAudio(int16_t *stereo, size_t frames) noexcept;
+
+    private:
+        struct Envelope
+        {
+            int32_t level = 0;
+            uint32_t counter = 0;
+        };
+
+        enum class Phase : uint8_t
+        {
+            Off,
+            Attack,
+            Decay,
+            Sustain,
+            Release,
+        };
+
+        struct Voice
+        {
+            uint16_t volL = 0, volR = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            Envelope sweepL, sweepR; // current volume (VOLXL/VOLXR) and its sweep counter
+            Envelope adsr;           // ENVX
+            Phase phase = Phase::Off;
+            uint32_t ssa = 0, lsax = 0, blockAddress = 0;
+            bool loopAddressSet = false; // LSAX written after key-on: header loop starts are ignored
+            bool needBlock = true;
+            uint8_t blockFlags = 0;
+            uint32_t counter = 0; // bits 12+: sample within the block, bits 4-11: interpolation index
+            int16_t adpcmPrev[2]{};
+            int16_t samples[3 + 28]{}; // last three samples of the previous block, then this block
+            int32_t outx = 0;
+        };
+
+        struct Core
+        {
+            std::array<Voice, 24> voices;
+            uint32_t pmon = 0, non = 0, vmixL = 0, vmixEL = 0, vmixR = 0, vmixER = 0, endx = 0;
+            uint16_t mmix = 0, attr = 0, statx = 0x80u, admas = 0;
+            uint32_t irqa = 0, tsa = 0, esa = 0;
+            uint16_t mvolL = 0, mvolR = 0;
+            Envelope masterL, masterR;
+            int16_t evolL = 0, evolR = 0, avolL = 0, avolR = 0, bvolL = 0, bvolR = 0;
+            int32_t noiseLevel = 1;
+            int32_t noiseTimer = 0;
+        };
+
+        struct StereoSample
+        {
+            int32_t left = 0;
+            int32_t right = 0;
+        };
+
+        static int32_t clamp16(int32_t value) noexcept;
+        static int32_t directVolume(uint16_t value) noexcept;
+        static void tickEnvelope(Envelope &envelope, uint32_t rate, uint32_t rateMask, bool decreasing, bool exponential, bool phaseNegative) noexcept;
+        static void tickSweep(Envelope &envelope, uint16_t reg) noexcept;
+
+        uint16_t readCoreRegister(int core, uint32_t offset);
+        void writeCoreRegister(int core, uint32_t offset, uint16_t value);
+        void keyOn(int core, uint32_t mask);
+        void keyOff(int core, uint32_t mask);
+        void checkIrq(uint32_t address) noexcept;
+        void checkIrqRange(uint32_t begin, uint32_t count) noexcept;
+        void raiseIrq(int core) noexcept;
+
+        void decodeBlock(Voice &voice) noexcept;
+        void tickAdsr(Voice &voice) noexcept;
+        void tickNoise(Core &core) noexcept;
+        StereoSample mixCore(int coreIndex, const StereoSample &external);
+        void tickSample();
+        void pushOutput(int16_t left, int16_t right) noexcept;
+        void writeWavHeader();
+
+        std::vector<uint16_t> m_ram;
+        std::array<Core, 2> m_cores;
+        std::array<uint16_t, kRegSize / 2u> m_regs{}; // raw values of registers without live state
+        uint16_t m_irqInfo = 0;                      // SPDIF_IRQINFO: bit 2 = core 0, bit 3 = core 1
+        bool m_irqRaised = false;
+        uint32_t m_outPos = 0; // capture area write position (0..0x1FF)
+        uint64_t m_cycle = 0;  // IOP cycle the next sample is due at
+        bool m_haveCycle = false;
+
+        // Single-producer (IOP thread) / single-consumer (host audio thread) output ring.
+        static constexpr uint32_t kRingFrames = 1u << 13;
+        std::vector<int16_t> m_ring;
+        std::atomic<uint32_t> m_ringWrite{0};
+        std::atomic<uint32_t> m_ringRead{0};
+
+        std::FILE *m_wav = nullptr; // PS2X_SPU2_WAV=path: everything the SPU2 produced
+        uint32_t m_wavFrames = 0;
+    };
+}
