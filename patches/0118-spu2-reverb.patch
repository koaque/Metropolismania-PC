+    uint32_t Spu2::reverbIndex(const Core &core, int32_t offset) const noexcept
+    {
+        const uint32_t start = core.esa;
+        const uint32_t end = core.eea;
+        const uint32_t size = end - start + 1u;
+        const uint32_t x = ((core.reverbCycle >> 1) + static_cast<uint32_t>(offset)) % size;
+        return (x + start) & kAddressMask;
+    }
+
+    // The reverb unit (psx-spx "SPU Reverb Formula", PS2 addressing as in PCSX2): it alternates
+    // between the left and right channel every sample, so each runs at 24 kHz, with 39-tap FIR
+    // filters resampling its input and output. ATTR bit 7 gates the work-area writes only.
+    Spu2::StereoSample Spu2::reverb(int coreIndex, StereoSample input) noexcept
+    {
+        Core &core = m_cores[static_cast<size_t>(coreIndex)];
+        const uint32_t pos = core.reverbPos;
+        const int16_t inL = static_cast<int16_t>(clamp16(input.left));
+        const int16_t inR = static_cast<int16_t>(clamp16(input.right));
+        core.reverbDown[0][pos] = core.reverbDown[0][pos | 64u] = inL;
+        core.reverbDown[1][pos] = core.reverbDown[1][pos | 64u] = inR;
+
+        const bool right = (core.reverbCycle & 1u) != 0u;
+        int16_t out = 0;
+        if (core.esa < core.eea)
+        {
+            const auto &a = core.reverbAddress;
+            const auto &v = core.reverbVolume;
+            const auto idx = [&](int32_t offset) { return reverbIndex(core, offset); };
+            const auto at = [this](uint32_t address) { return static_cast<int32_t>(static_cast<int16_t>(m_ram[address])); };
+            const auto mul = [](int32_t x, int32_t y) { return (x * y) >> 15; };
+
+            const uint32_t sameSrc = idx(static_cast<int32_t>(a[right ? kSameRSrc : kSameLSrc]));
+            const uint32_t sameDst = idx(static_cast<int32_t>(a[right ? kSameRDst : kSameLDst]));
+            const uint32_t samePrv = idx(static_cast<int32_t>(a[right ? kSameRDst : kSameLDst]) - 1);
+            const uint32_t diffSrc = idx(static_cast<int32_t>(a[right ? kDiffLSrc : kDiffRSrc]));
+            const uint32_t diffDst = idx(static_cast<int32_t>(a[right ? kDiffRDst : kDiffLDst]));
+            const uint32_t diffPrv = idx(static_cast<int32_t>(a[right ? kDiffRDst : kDiffLDst]) - 1);
+            const uint32_t comb1 = idx(static_cast<int32_t>(a[right ? kComb1R : kComb1L]));
+            const uint32_t comb2 = idx(static_cast<int32_t>(a[right ? kComb2R : kComb2L]));
+            const uint32_t comb3 = idx(static_cast<int32_t>(a[right ? kComb3R : kComb3L]));
+            const uint32_t comb4 = idx(static_cast<int32_t>(a[right ? kComb4R : kComb4L]));
+            const uint32_t apf1Dst = idx(static_cast<int32_t>(a[right ? kApf1RDst : kApf1LDst]));
+            const uint32_t apf1Src = idx(static_cast<int32_t>(a[right ? kApf1RDst : kApf1LDst] - a[kApf1Size]));
+            const uint32_t apf2Dst = idx(static_cast<int32_t>(a[right ? kApf2RDst : kApf2LDst]));
+            const uint32_t apf2Src = idx(static_cast<int32_t>(a[right ? kApf2RDst : kApf2LDst] - a[kApf2Size]));
+
+            if ((core.attr & 0x80u) != 0u)
+            {
+                for (int c = 0; c < 2; ++c)
+                {
+                    const uint32_t irqa = m_cores[static_cast<size_t>(c)].irqa;
+                    if (irqa >= core.esa && irqa <= core.eea &&
+                        (irqa == sameSrc || irqa == sameDst || irqa == samePrv || irqa == diffSrc || irqa == diffDst ||
+                         irqa == diffPrv || irqa == comb1 || irqa == comb2 || irqa == comb3 || irqa == comb4 ||
+                         irqa == apf1Dst || irqa == apf1Src || irqa == apf2Dst || irqa == apf2Src))
+                        raiseIrq(c);
+                }
+            }
+
+            int32_t down = 0;
+            const int16_t *history = core.reverbDown[right ? 1 : 0] + ((pos - 39u) & 63u);
+            for (int i = 0; i < 39; ++i)
+                down += history[i] * kReverbFir[i];
+            down = clamp16(down >> 15);
+
+            const int32_t in = mul(v[right ? kInCoefR : kInCoefL], down);
+            const int32_t same = mul(v[kIirVol], in + mul(v[kWallVol], at(sameSrc)) - at(samePrv)) + at(samePrv);
+            const int32_t diff = mul(v[kIirVol], in + mul(v[kWallVol], at(diffSrc)) - at(diffPrv)) + at(diffPrv);
+            int32_t result = mul(v[kComb1Vol], at(comb1)) + mul(v[kComb2Vol], at(comb2)) +
+                             mul(v[kComb3Vol], at(comb3)) + mul(v[kComb4Vol], at(comb4));
+            const int32_t apf1 = result - mul(v[kApf1Vol], at(apf1Src));
+            result = at(apf1Src) + mul(v[kApf1Vol], apf1);
+            const int32_t apf2 = result - mul(v[kApf2Vol], at(apf2Src));
+            result = at(apf2Src) + mul(v[kApf2Vol], apf2);
+            if ((core.attr & 0x80u) != 0u)
+            {
+                m_ram[sameDst] = static_cast<uint16_t>(clamp16(same));
+                m_ram[diffDst] = static_cast<uint16_t>(clamp16(diff));
+                m_ram[apf1Dst] = static_cast<uint16_t>(clamp16(apf1));
+                m_ram[apf2Dst] = static_cast<uint16_t>(clamp16(apf2));
+            }
+            out = static_cast<int16_t>(clamp16(result));
+        }
+
+        const int side = right ? 1 : 0;
+        core.reverbUp[side][pos] = core.reverbUp[side][pos | 64u] = out;
+        core.reverbUp[side ^ 1][pos] = core.reverbUp[side ^ 1][pos | 64u] = 0;
+        core.reverbPos = (pos + 1u) & 63u;
+        ++core.reverbCycle;
+
+        StereoSample result;
+        const uint32_t start = (core.reverbPos - 39u) & 63u;
+        for (int i = 0; i < 39; ++i)
+        {
+            const int32_t coefficient = std::clamp<int32_t>(kReverbFir[i] * 2, -0x8000, 0x7FFF);
+            result.left += core.reverbUp[0][start + i] * coefficient;
+            result.right += core.reverbUp[1][start + i] * coefficient;
+        }
+        result.left = clamp16(result.left >> 15);
+        result.right = clamp16(result.right >> 15);
+        return result;
+    }
