+                                 c, core.attr, core.mmix, core.evolL, core.evolR, core.masterL.level, core.masterR.level,
+                                 core.esa, core.eea, active, c == 0 ? " | " : "");
+                }
+                std::fprintf(stderr, " peak=%u\n", peak);
+                samples = 0;
+                peak = 0;
