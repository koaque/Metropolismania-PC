+        // Module start code (and other guest code called synchronously) runs without a current
+        // IOP thread, so a WaitEventFlag there cannot block; the kernel would fail it at once. On
+        // hardware it would simply wait, usually for a DMA completion interrupt whose handler sets
+        // the flag (libsd's transfers, e.g. clearing the reverb work area at sound driver start).
+        // Let IOP time run to the pending interrupts until the flag is set.
+        void runUntilEventFlag(int id, uint32_t bits, uint32_t mode)
+        {
+            for (int guard = 0; guard < 64 && !kernel.eventFlagReady(id, bits, mode); ++guard)
+            {
+                if (pendingDmaInterrupts.empty())
+                    return;
+                uint64_t next = UINT64_MAX;
+                for (const auto &[irq, completionCycle] : pendingDmaInterrupts)
+                    next = std::min(next, completionCycle);
+                totalCycles = std::max(totalCycles, next);
+                servicePendingDmaInterrupts();
+            }
+        }
