+// Threads that wait by yielding in a loop (RotateThreadReadyQueue until a flag changes) only move
+// emulated time forward by the few instructions between yields, while every yield costs real host
+// time, so the vsync or interrupt they wait for takes far too long to arrive (a movie ran at a few
+// fields per second). When many yields go by with no wakeup, interrupt or scheduler event in
+// between, nothing can change until the next scheduled event: skip ahead to it, at most one vsync
+// period. Host time still paces vsync, so this does not run the game faster than real time.
+void EeScheduler::noteYield()
+{
+    constexpr uint32_t kSpinYields = 200u;
+    if (++m_yieldsSinceEvent < kSpinYields)
+        return;
+    m_yieldsSinceEvent = 0;
+    const uint64_t next = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    if (next > m_eeCycle)
+    {
+        const uint64_t skip = std::min<uint64_t>(next - m_eeCycle, kVBlankPeriodCycles);
+        accountCycles(static_cast<uint32_t>(skip));
+        m_checkpointPending.store(true, std::memory_order_release);
+    }
+}
