+    bool Spu2::admaEnabled(int coreIndex) const noexcept
+    {
+        return (m_cores[static_cast<size_t>(coreIndex)].admas & static_cast<uint16_t>(coreIndex + 1)) != 0u;
+    }
+
+    void Spu2::startAdma(int coreIndex, uint32_t madr, uint32_t bytes)
+    {
+        AdmaStream &stream = m_adma[static_cast<size_t>(coreIndex)];
+        stream.active = bytes >= 0x400u;
+        stream.finished = !stream.active;
+        stream.madr = madr;
+        stream.remaining = bytes & ~0x3FFu;
+        if (stream.active && !stream.primed)
+        {
+            // A new stream fills both halves of the input area before playback reads from it.
+            stream.inputPos = 0;
+            fillAdmaHalf(coreIndex, 0);
+            if (stream.active)
+                fillAdmaHalf(coreIndex, 1);
+            stream.primed = true;
+        }
+    }
+
+    // Copies the next 1 KB of the stream into one half of the core's input area: 256 left
+    // samples at 0x2000 + core * 0x400 (+ half * 0x100), then 256 right samples 0x200 further.
+    bool Spu2::fillAdmaHalf(int coreIndex, uint32_t half) noexcept
+    {
+        AdmaStream &stream = m_adma[static_cast<size_t>(coreIndex)];
+        if (!stream.active || !m_iopRam || stream.madr + 0x400u > m_iopRamSize)
+        {
+            stream.active = false;
+            stream.finished = true;
+            return false;
+        }
+        const uint32_t base = 0x2000u + static_cast<uint32_t>(coreIndex) * 0x400u + half * 0x100u;
+        std::memcpy(&m_ram[base], m_iopRam + stream.madr, 0x200u);
+        std::memcpy(&m_ram[base + 0x200u], m_iopRam + stream.madr + 0x200u, 0x200u);
+        checkIrqRange(base, 0x100u);
+        checkIrqRange(base + 0x200u, 0x100u);
+        stream.madr += 0x400u;
+        stream.remaining -= 0x400u;
+        if (stream.remaining == 0u)
+        {
+            stream.active = false;
+            stream.finished = true;
+        }
+        return true;
+    }
+
+    bool Spu2::takeAdmaFinished(int coreIndex) noexcept
+    {
+        AdmaStream &stream = m_adma[static_cast<size_t>(coreIndex)];
+        const bool finished = stream.finished;
+        stream.finished = false;
+        return finished;
+    }
+
+    Spu2::StereoSample Spu2::readInput(int coreIndex) noexcept
+    {
+        AdmaStream &stream = m_adma[static_cast<size_t>(coreIndex)];
+        if (!stream.primed)
+            return {};
+        const uint32_t base = 0x2000u + static_cast<uint32_t>(coreIndex) * 0x400u;
+        const StereoSample sample{static_cast<int16_t>(m_ram[base + stream.inputPos]),
+                                  static_cast<int16_t>(m_ram[base + 0x200u + stream.inputPos])};
+        stream.inputPos = (stream.inputPos + 1u) & 0x1FFu;
+        if ((stream.inputPos & 0xFFu) == 0u)
+        {
+            // The half just played is refilled from the stream; when the transfer is used up the
+            // DMA completes and the driver queues the next one (or playback has ended).
+            if (!fillAdmaHalf(coreIndex, (stream.inputPos >> 8) ^ 1u) && !stream.active)
+                stream.primed = (m_adma[static_cast<size_t>(coreIndex)].remaining != 0u);
+        }
+        return sample;
+    }
