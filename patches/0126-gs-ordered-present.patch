+// The worker presents when it reaches this command, so the frame holds exactly what was drawn
+// before it, however far behind the worker is. Waiting first and reading VRAM afterwards (Present)
+// lets the EE run on during the wait: it can flip DISPFB and clear the buffer the request names.
+std::function<PresentationFrame()> GSThreadedBackend::QueuePresent(const GSPresentationRequest &request)
+{
+    auto args = std::make_shared<PresentArgs>();
+    args->request = request;
+    args->snapshotOnly = m_impl->cpu != nullptr;
+    std::shared_future<void> done = args->done.get_future().share();
+    m_impl->push(Command{Op::Present, std::fegetround(), args});
+    return [args, done]()
+    {
+        done.get();
+        if (args->snapshotOnly)
+            return GSCpuBackend::PresentFromSnapshot(args->snapshot, args->request);
+        return std::move(args->frame);
+    };
+}
