+bool VU1Interpreter::saveIdleScheduler(IdleScheduler &out) const
+{
+    if (pipelinesPending())
+        return false;
+    out = {};
+    out.vfReady = m_vfReady;
+    out.viReady = m_viReady;
+    out.accReady = m_accReady;
+    out.vfLatestWrite = m_vfLatestWrite;
+    out.viLatestWrite = m_viLatestWrite;
+    out.accLatestWrite = m_accLatestWrite;
+    out.cycle = m_cycle;
+    out.nextWriteSequence = m_nextWriteSequence;
+    out.efuResourceReady = m_efuResourceReady;
+    out.workingClip = m_workingClip;
+    out.viBranchBackupValue = m_viBranchBackupValue;
+    out.viBranchBackupReg = m_viBranchBackupReg;
+    out.viBranchBackupValid = m_viBranchBackupValid;
+    out.stopRequested = m_stopRequested;
+    out.pendingHaltD = m_pendingHaltD;
+    out.pendingHaltT = m_pendingHaltT;
+    return true;
+}
+
+void VU1Interpreter::restoreIdleScheduler(const IdleScheduler &in)
+{
+    resetScheduler();
+    m_vfReady = in.vfReady;
+    m_viReady = in.viReady;
+    m_accReady = in.accReady;
+    m_vfLatestWrite = in.vfLatestWrite;
+    m_viLatestWrite = in.viLatestWrite;
+    m_accLatestWrite = in.accLatestWrite;
+    m_cycle = in.cycle;
+    m_nextWriteSequence = in.nextWriteSequence;
+    m_efuResourceReady = in.efuResourceReady;
+    m_workingClip = in.workingClip;
+    m_viBranchBackupValue = in.viBranchBackupValue;
+    m_viBranchBackupReg = in.viBranchBackupReg;
+    m_viBranchBackupValid = in.viBranchBackupValid;
+    m_stopRequested = in.stopRequested;
+    m_pendingHaltD = in.pendingHaltD;
+    m_pendingHaltT = in.pendingHaltT;
+}
