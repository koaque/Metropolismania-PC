+    // PS2X_VU1_CAPTURE=<dir>: writes whole program runs (MSCAL) there, for replay outside the game (src/port/vu1test.cpp).
+    // execute() clears the pipelines, so a run is a function of the code, the data memory, the registers and flags in
+    // VU1State, TOP/ITOP and the start PC. A resume (MSCNT) also depends on the scheduler's scoreboards, which are saved when
+    // the previous run drained its pipelines (as an E-bit end does); a resume that starts with a busy pipeline is not
+    // captured. Per (code, start PC, kind) the
+    // runs 0 to 3 and then every power of two are kept, up to PS2X_VU1_CAPTURE_MAX (default 12) files.
+    // A file is: "VU1R", version 2, kind (0 MSCAL, 1 MSCNT), startPC, top, itop, maxCycles, codeSize, dataSize, stateSize,
+    // schedulerSize (u32 each), cycles before and after (u64 each), then state before, the idle scheduler before (zeros for
+    // MSCAL), code, data before, state after, data after, packet count (u32) and each packet as a u32 size and its bytes.
+    const char *vu1CaptureDir()
+    {
+        static const char *dir = std::getenv("PS2X_VU1_CAPTURE");
+        return dir != nullptr && dir[0] != '\0' ? dir : nullptr;
+    }
+
+    uint64_t vu1Fnv1a(const uint8_t *bytes, size_t size, uint64_t hash)
+    {
+        for (size_t i = 0; i < size; ++i)
+        {
+            hash ^= bytes[i];
+            hash *= 1099511628211ull;
+        }
+        return hash;
+    }
+
+    struct Vu1CaptureRun
+    {
+        bool active = false;
+        uint32_t kind = 0; // 0 MSCAL (execute), 1 MSCNT (resume)
+        VU1Interpreter::IdleScheduler scheduler{};
+        std::string path;
+        VU1State stateBefore{};
+        std::vector<uint8_t> dataBefore;
+        std::vector<uint8_t> packets; // u32 size, bytes, per packet
+        uint32_t packetCount = 0;
+        uint64_t cyclesBefore = 0;
+    };
+
+    Vu1CaptureRun vu1CaptureBegin(uint32_t kind, const VU1State &state, uint64_t cycles, const uint8_t *code, uint32_t codeSize,
+                                  const uint8_t *data, uint32_t dataSize, uint32_t startPC)
+    {
+        static std::unordered_map<uint64_t, uint32_t> runsPerKey;
+        static std::unordered_map<uint64_t, uint32_t> keptPerKey;
+        static const uint32_t maxKept = []()
+        {
+            const char *value = std::getenv("PS2X_VU1_CAPTURE_MAX");
+            return value != nullptr ? static_cast<uint32_t>(std::atoi(value)) : 12u;
+        }();
+        Vu1CaptureRun run;
+        const uint64_t key = vu1Fnv1a(code, codeSize, 1469598103934665603ull) ^ (static_cast<uint64_t>(startPC) * 0x9E3779B97F4A7C15ull) ^
+                             (static_cast<uint64_t>(kind) << 62);
+        const uint32_t n = runsPerKey[key]++;
+        if ((n >= 4u && (n & (n - 1u)) != 0u) || keptPerKey[key] >= maxKept)
+            return run;
+        std::error_code ignored;
+        std::filesystem::create_directories(vu1CaptureDir(), ignored);
+        char name[64];
+        std::snprintf(name, sizeof(name), "%016llx_%c%04x_%03u.vu1r", static_cast<unsigned long long>(key), kind == 0 ? 'm' : 'c', startPC,
+                      keptPerKey[key]++);
+        run.active = true;
+        run.kind = kind;
+        run.path = (std::filesystem::path(vu1CaptureDir()) / name).string();
+        run.stateBefore = state;
+        run.dataBefore.assign(data, data + dataSize);
+        run.cyclesBefore = cycles;
+        return run;
+    }
+
+    void vu1CaptureEnd(const Vu1CaptureRun &run, const VU1State &stateAfter, uint64_t cyclesAfter, const uint8_t *code, uint32_t codeSize,
+                       const uint8_t *data, uint32_t dataSize, uint32_t startPC, uint32_t top, uint32_t itop, uint32_t maxCycles)
+    {
+        std::ofstream out(run.path, std::ios::binary);
+        const auto u32 = [&](uint32_t value) { out.write(reinterpret_cast<const char *>(&value), sizeof(value)); };
+        const auto u64 = [&](uint64_t value) { out.write(reinterpret_cast<const char *>(&value), sizeof(value)); };
+        out.write("VU1R", 4);
+        u32(2u);
+        u32(run.kind);
+        u32(startPC);
+        u32(top);
+        u32(itop);
+        u32(maxCycles);
+        u32(codeSize);
+        u32(dataSize);
+        u32(static_cast<uint32_t>(sizeof(VU1State)));
+        u32(static_cast<uint32_t>(sizeof(VU1Interpreter::IdleScheduler)));
+        u64(run.cyclesBefore);
+        u64(cyclesAfter);
+        out.write(reinterpret_cast<const char *>(&run.stateBefore), sizeof(VU1State));
+        out.write(reinterpret_cast<const char *>(&run.scheduler), sizeof(VU1Interpreter::IdleScheduler));
+        out.write(reinterpret_cast<const char *>(code), codeSize);
+        out.write(reinterpret_cast<const char *>(run.dataBefore.data()), static_cast<std::streamsize>(run.dataBefore.size()));
+        out.write(reinterpret_cast<const char *>(&stateAfter), sizeof(VU1State));
+        out.write(reinterpret_cast<const char *>(data), dataSize);
+        u32(run.packetCount);
+        out.write(reinterpret_cast<const char *>(run.packets.data()), static_cast<std::streamsize>(run.packets.size()));
+    }
 }
 
