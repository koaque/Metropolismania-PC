+VU1Interpreter::FmacFn VU1Interpreter::classifyFmac(uint32_t instr)
+{
+    const FmacTable &table = fmacTable();
+    const uint32_t op = instr & 0x3Fu;
+    if (op < 0x3Cu)
+        return table.main[op];
+    const uint32_t special = (instr & 3u) | ((instr >> 4) & 0x7Cu);
+    if (special == 0x2Fu || special == 0x30u)
+        return &VU1Interpreter::upperNop; // NOP (execUpper does nothing for it either)
+    return special < table.special.size() ? table.special[special] : nullptr;
+}
