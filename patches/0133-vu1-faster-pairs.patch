+// The next free place at the end of the flag ring, with every field cleared and the timing filled in (null when full).
+VU1Interpreter::FlagPipelineEntry *VU1Interpreter::pushFlagEntry(bool upper, uint32_t reservedCode)
+{
+    if (m_flagCount == kMaxFlagEntries)
+    {
+        reportReservedInstruction(upper, reservedCode);
+        return nullptr;
+    }
+    FlagPipelineEntry &entry = m_flagPipeline[(m_flagHead + m_flagCount) % kMaxFlagEntries];
+    ++m_flagCount;
+    entry = {};
+    entry.valid = true;
+    entry.issueCycle = m_cycle;
+    entry.readyCycle = m_cycle + kFmacLatency;
+    m_nextCommitCycle = std::min(m_nextCommitCycle, entry.readyCycle);
+    return &entry;
+}
