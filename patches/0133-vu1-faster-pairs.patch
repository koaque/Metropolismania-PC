+uint32_t VU1Interpreter::checkFmacExecutors(uint32_t seed, uint32_t cases, std::string &firstFailure)
+{
+    uint64_t rng = 0x9E3779B97F4A7C15ull ^ (static_cast<uint64_t>(seed) << 32 | seed);
+    const auto next = [&rng]()
+    {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        return static_cast<uint32_t>(rng >> 16);
+    };
+    const auto randomFloat = [&]()
+    {
+        static const uint32_t special[] = {0x00000000u, 0x80000000u, 0x00000001u, 0x80000001u, 0x007FFFFFu, 0x807FFFFFu, 0x00800000u, 0x80800000u,
+                                           0x3F800000u, 0xBF800000u, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x7F800000u, 0xFF800000u, 0x7FC00000u, 0x7F000000u,
+                                           0xFF000000u, 0x00FFFFFFu, 0x3F000000u, 0x40000000u, 0x7E800000u, 0x01000000u};
+        const uint32_t pick = next();
+        uint32_t bits;
+        if ((pick & 7u) < 3u)
+            bits = special[(pick >> 3) % (sizeof(special) / sizeof(special[0]))];
+        else if ((pick & 7u) < 5u)
+            bits = next();
+        else
+            bits = ((next() & 1u) << 31) | ((1u + next() % 253u) << 23) | (next() & 0x7FFFFFu); // normal numbers of any size
+        float value;
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    };
+    const int previousRounding = std::fegetround();
+    std::fesetround(FE_TOWARDZERO);
+    const VU1State savedState = m_state;
+    const uint32_t savedHead = m_flagHead, savedCount = m_flagCount;
+    const uint64_t savedNextCommit = m_nextCommitCycle;
