+// Kind: 0 ADD, 1 SUB, 2 MUL, 3 MADD (ACC + vs * b), 4 MSUB (ACC - vs * b). BSrc: 0 to 3 broadcast lane of vt, 4 Q, 5 I,
+// 6 vt lane by lane. ToAcc: the result goes to ACC instead of vf[fd]. The arithmetic is that of execUpper and
+// calculateFmacExactResult, done on all four lanes at once (float results, round toward zero as run() sets it; the exact
+// results in double, as the model's long double is) and used for the lanes in dest only.
+template <int Kind, int BSrc, bool ToAcc>
+void VU1Interpreter::fmacArith(uint32_t instr)
+{
+    const uint8_t dest = DEST(instr);
+    const LaneTables &tables = laneTables();
+    const uint32_t lanes = tables.reverse[dest]; // components in dest, bit = component
+    const __m128 vs = normalizeLanes(_mm_loadu_ps(m_state.vf[FS(instr)]));
+    __m128 b;
+    if constexpr (BSrc <= 3)
+        b = normalizeLanes(_mm_set1_ps(m_state.vf[FT(instr)][BSrc]));
+    else if constexpr (BSrc == 4)
+        b = normalizeLanes(_mm_set1_ps(m_state.q));
+    else if constexpr (BSrc == 5)
+        b = normalizeLanes(_mm_set1_ps(m_state.i));
+    else
+        b = normalizeLanes(_mm_loadu_ps(m_state.vf[FT(instr)]));
+
+    __m128 result;
+    __m256d exact;
+    uint32_t extraSticky = 0u;
+    if constexpr (Kind <= 2)
+    {
+        const __m256d dvs = _mm256_cvtps_pd(vs), db = _mm256_cvtps_pd(b);
+        if constexpr (Kind == 0)
+        {
+            result = _mm_add_ps(vs, b);
+            exact = _mm256_add_pd(dvs, db);
+        }
+        else if constexpr (Kind == 1)
+        {
+            result = _mm_sub_ps(vs, b);
+            exact = _mm256_sub_pd(dvs, db);
+        }
+        else
+        {
+            result = _mm_mul_ps(vs, b);
+            exact = _mm256_mul_pd(dvs, db);
+        }
+    }
+    else
+    {
+        const __m128 acc = normalizeLanes(_mm_loadu_ps(m_state.acc));
+        const __m256d dvs = _mm256_cvtps_pd(vs), db = _mm256_cvtps_pd(b), dacc = _mm256_cvtps_pd(acc);
+        const __m128 product = _mm_mul_ps(vs, b);
+        const __m256d exactProduct = _mm256_mul_pd(dvs, db);
+        if constexpr (Kind == 3)
+        {
+            result = _mm_add_ps(acc, product);
+            exact = _mm256_add_pd(dacc, exactProduct);
+        }
+        else
+        {
+            result = _mm_sub_ps(acc, product);
+            exact = _mm256_sub_pd(dacc, exactProduct);
+        }
+        // Every product condition accumulates into the sticky flags (the product's own value does not matter here).
+        __m256d zeroMask, underMask, overMask;
+        const ExactClass p = classifyExact(exactProduct, zeroMask, underMask, overMask);
+        extraSticky = ((p.zero & lanes) != 0u ? 1u : 0u) | ((p.negative & lanes) != 0u ? 2u : 0u) |
+                      ((p.underflow & lanes) != 0u ? 4u : 0u) | ((p.overflow & lanes) != 0u ? 8u : 0u);
+    }
+
+    // The conditions of the exact result decide the flags and replace the float result where it is zero or out of range.
+    __m256d zeroMask, underMask, overMask;
+    const ExactClass c = classifyExact(exact, zeroMask, underMask, overMask);
+    const __m128i signBits = _mm_and_si128(tables.mask[c.negative], _mm_set1_epi32(static_cast<int>(0x80000000u)));
+    __m128i resultBits = _mm_castps_si128(result);
+    resultBits = _mm_blendv_epi8(resultBits, signBits, tables.mask[c.zero]);
+    resultBits = _mm_blendv_epi8(resultBits, _mm_or_si128(signBits, _mm_set1_epi32(0x7F7FFFFF)), tables.mask[c.overflow]);
+    result = _mm_castsi128_ps(resultBits);
+
+    if (dest != 0u)
+    {
+        const uint32_t mac = static_cast<uint32_t>(tables.reverse[c.zero & lanes]) | (static_cast<uint32_t>(tables.reverse[c.negative & lanes]) << 4) |
+                             (static_cast<uint32_t>(tables.reverse[c.underflow & lanes]) << 8) | (static_cast<uint32_t>(tables.reverse[c.overflow & lanes]) << 12);
+        const uint32_t status = ((c.zero & lanes) != 0u ? 1u : 0u) | ((c.negative & lanes) != 0u ? 2u : 0u) |
+                                ((c.underflow & lanes) != 0u ? 4u : 0u) | ((c.overflow & lanes) != 0u ? 8u : 0u);
+        pushFmacFlags(mac, status, extraSticky);
+    }
+    float *target = ToAcc ? m_state.acc : m_state.vf[FD(instr)];
+    const __m128 old = _mm_loadu_ps(target);
+    _mm_storeu_ps(target, _mm_blendv_ps(old, result, _mm_castsi128_ps(tables.mask[lanes])));
+}
+
+const VU1Interpreter::FmacTable &VU1Interpreter::fmacTable()
+{
+    static const FmacTable table = []()
+    {
+        FmacTable t;
+        const auto set = [&t](bool special, uint32_t index, FmacFn fn) { (special ? t.special[index] : t.main[index]) = fn; };
+        // One entry per instruction: the main group (ToAcc false) and the special group (ToAcc true) share the same layout.
+        const auto build = [&](bool special)
+        {
+            const auto put = [&](uint32_t op, FmacFn fn) { set(special, op, fn); };
+#define FMAC_BC(OPBASE, KIND)                                                                                 \
+    put((OPBASE) + 0, special ? &VU1Interpreter::fmacArith<KIND, 0, true> : &VU1Interpreter::fmacArith<KIND, 0, false>); \
+    put((OPBASE) + 1, special ? &VU1Interpreter::fmacArith<KIND, 1, true> : &VU1Interpreter::fmacArith<KIND, 1, false>); \
+    put((OPBASE) + 2, special ? &VU1Interpreter::fmacArith<KIND, 2, true> : &VU1Interpreter::fmacArith<KIND, 2, false>); \
+    put((OPBASE) + 3, special ? &VU1Interpreter::fmacArith<KIND, 3, true> : &VU1Interpreter::fmacArith<KIND, 3, false>)
+#define FMAC_ONE(OP, KIND, BSRC) \
+    put((OP), special ? &VU1Interpreter::fmacArith<KIND, BSRC, true> : &VU1Interpreter::fmacArith<KIND, BSRC, false>)
+            FMAC_BC(0x00, 0);
+            FMAC_BC(0x04, 1);
+            FMAC_BC(0x08, 3);
+            FMAC_BC(0x0C, 4);
+            FMAC_BC(0x18, 2);
+            FMAC_ONE(0x1C, 2, 4); // MULq
+            FMAC_ONE(0x1E, 2, 5); // MULi
+            FMAC_ONE(0x20, 0, 4); // ADDq
+            FMAC_ONE(0x21, 3, 4); // MADDq
+            FMAC_ONE(0x22, 0, 5); // ADDi
+            FMAC_ONE(0x23, 3, 5); // MADDi
+            FMAC_ONE(0x24, 1, 4); // SUBq
+            FMAC_ONE(0x25, 4, 4); // MSUBq
+            FMAC_ONE(0x26, 1, 5); // SUBi
+            FMAC_ONE(0x27, 4, 5); // MSUBi
+            FMAC_ONE(0x28, 0, 6); // ADD
+            FMAC_ONE(0x29, 3, 6); // MADD
+            FMAC_ONE(0x2A, 2, 6); // MUL
+            FMAC_ONE(0x2C, 1, 6); // SUB
+            FMAC_ONE(0x2D, 4, 6); // MSUB
+#undef FMAC_BC
+#undef FMAC_ONE
+        };
+        build(false);
+        build(true);
+        return t;
+    }();
+    return table;
+}
