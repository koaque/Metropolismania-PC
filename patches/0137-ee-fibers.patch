+
+GuestFiberRef *EeScheduler::findFiberSlot(GuestThread &thread, const GuestFiber *fiber)
+{
+    if (thread.fiber.get() == fiber)
+        return &thread.fiber;
+    for (GuestInvocation &invocation : thread.invocations)
+        if (invocation.fiber.get() == fiber)
+            return &invocation.fiber;
+    return nullptr;
+}
+
+GuestFiberRef EeScheduler::acquireFiber()
+{
+    if (!m_fiberPool.empty())
+    {
+        GuestFiberRef fiber = std::move(m_fiberPool.back());
+        m_fiberPool.pop_back();
+        return fiber;
+    }
+    return GuestFiberRef(new GuestFiber());
+}
+
+bool EeScheduler::fibersAvailable() const noexcept
+{
+    return m_fibersEnabled && m_dispatching && GuestFiber::dispatcherReady() &&
+           m_executorThread == std::this_thread::get_id() && m_currentThreadId != 0;
+}
+
+GuestFiber::State EeScheduler::enterFiber(GuestFiber &fiber, std::function<void()> body)
+{
+    const uint32_t outerDepth = m_noPreemptDepth;
+    m_noPreemptDepth = fiber.savedNoPreempt;
+    if (m_fiberHooks.enter)
+        m_fiberHooks.enter(fiber);
+    m_currentFiber = &fiber;
+    if (fiber.state() == GuestFiber::State::Parked)
+        ++m_fiberResumes;
+    else
+        ++m_fiberStarts;
+    fiber.switchIn(std::move(body));
+    m_currentFiber = nullptr;
+    if (fiber.state() == GuestFiber::State::Parked)
+        ++m_fiberParks;
+    static const bool statsOn = [] {
+        const char *value = std::getenv("PS2X_FIBER_STATS");
+        return value != nullptr && value[0] == '1';
+    }();
+    if (statsOn)
+    {
+        const auto now = std::chrono::steady_clock::now();
+        if (m_fiberStatsLast.time_since_epoch().count() == 0)
+            m_fiberStatsLast = now;
+        else if (now - m_fiberStatsLast >= std::chrono::seconds(5))
+        {
+            std::cerr << "[fibers] started=" << m_fiberStarts << " parked=" << m_fiberParks << " (checkpoint yields " << m_fiberYields
+                      << ") resumed=" << m_fiberResumes << " pooled=" << m_fiberPool.size() << std::endl;
+            m_fiberStarts = m_fiberParks = m_fiberYields = m_fiberResumes = 0;
+            m_fiberStatsLast = now;
+        }
+    }
+    if (m_fiberHooks.leave)
+        m_fiberHooks.leave(fiber);
+    fiber.savedNoPreempt = m_noPreemptDepth;
+    m_noPreemptDepth = outerDepth;
+    return fiber.state();
+}
+
+void EeScheduler::settleFiber(GuestFiber *fiber, int ownerId, GuestFiber::State state)
+{
+    if (state == GuestFiber::State::Parked)
+        return;
+    GuestThread *owner = thread(ownerId);
+    GuestFiberRef *slot = owner != nullptr ? findFiberSlot(*owner, fiber) : nullptr;
+    if (state == GuestFiber::State::Abandoned)
+    {
+        // Its thread is gone (or never comes back to it): the frames are dropped.
+        if (slot != nullptr)
+            slot->reset();
+        return;
+    }
+    // Finished: the body returned or threw.
+    std::exception_ptr error = fiber->takeError();
+    if (slot != nullptr)
+    {
+        GuestFiberRef finished = std::move(*slot);
+        finished->ownerThread = 0;
+        m_fiberPool.push_back(std::move(finished));
+    }
+    if (error)
+        std::rethrow_exception(error);
+}
+
+void EeScheduler::runOnFiber(std::function<void()> body)
+{
+    assertExecutor();
+    assert(m_currentFiber == nullptr && fibersAvailable());
+    GuestThread *self = currentThread();
+    assert(self != nullptr);
+    GuestFiberRef &slot = activeFiberSlot(*self);
+    assert(!slot);
+    slot = acquireFiber();
+    GuestFiber *fiber = slot.get();
+    fiber->ownerThread = self->id;
+    fiber->savedNoPreempt = 0u;
+    const int ownerId = self->id;
+    const GuestFiber::State state = enterFiber(*fiber, std::move(body));
+    settleFiber(fiber, ownerId, state);
+    if (state != GuestFiber::State::Finished)
+    {
+        // Parked or abandoned: the thread has left the processor; unwind what the dispatcher's stack holds above us.
+        throw EeDispatcherTransfer{};
+    }
+}
+
+void EeScheduler::parkFiber()
+{
