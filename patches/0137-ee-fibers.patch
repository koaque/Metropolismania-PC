EE scheduler: fibers for hand-written functions that must survive a thread switch (plan P6). A GuestFiber is a host fiber; EeScheduler::runOnFiber runs a body on one for the current thread's slot, callOnFiber enters guest code from it and parks the fiber when a thread switch unwinds that code, yieldIfDue gives the processor up at a due checkpoint, and run() resumes a parked fiber instead of entering ctx->pc. PS2X_FIBERS=0 turns it off; PS2X_FIBER_STATS=1 reports fiber counts every 5 seconds; PS2X_FIBER_FORCE_YIELD=1 parks a fiber before every guest call (a stress test of the park and resume path).

diff --git a/ps2xRuntime/include/runtime/ee_fiber.h b/ps2xRuntime/include/runtime/ee_fiber.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ee_fiber.h
@@ -0,0 +1,72 @@
+#pragma once
+
+// A host fiber a guest thread can park in (plan P6 of the Metropolismania port).
+//
+// The EE scheduler runs every guest thread on one host thread and switches threads by throwing
+// EeDispatcherTransfer, which unwinds every host frame; recompiled code does not mind because all its state is in the
+// R5900 context and the guest stack. Hand-written C++ that replaces a recompiled function keeps its state in host
+// frames, so it runs on a GuestFiber: when the thread has to give up the processor, the fiber is parked with its frames
+// intact, the dispatcher carries on, and when the thread is chosen again the dispatcher switches back into the fiber.
+// The dispatcher is the executor thread converted to a fiber for the time the scheduler runs.
+
+#include <cstdint>
+#include <exception>
+#include <functional>
+#include <memory>
+
+class GuestFiber
+{
+public:
+    enum class State : uint8_t
+    {
+        Idle,      // no body running
+        Running,
+        Parked,    // switched out with its frames intact; resumed by switchIn
+        Finished,  // the body returned (or threw: takeError)
+        Abandoned  // switched out for good (its thread is gone); only deleted
+    };
+
+    GuestFiber();
+    ~GuestFiber();
+    GuestFiber(const GuestFiber &) = delete;
+    GuestFiber &operator=(const GuestFiber &) = delete;
+
+    // Dispatcher side: starts `body` on an Idle or Finished fiber, or resumes a Parked one (body ignored). Returns when the
+    // fiber parks, finishes or is abandoned.
+    void switchIn(std::function<void()> body = {});
+    // Fiber side: back to the dispatcher in `state` (Parked or Abandoned). Returns when switched in again.
+    void switchOut(State state);
+
+    [[nodiscard]] State state() const noexcept { return m_state; }
+    // The exception the body ended with, if any (cleared).
+    [[nodiscard]] std::exception_ptr takeError() noexcept;
+
+    int ownerThread = 0;               // guest thread id (EeScheduler)
+    uint32_t savedNoPreempt = 0;       // the scheduler's no-preempt depth while this fiber is switched out
+    alignas(16) unsigned char user[128] = {}; // state of the host code layered on top (the port layer's call state)
+
+    // The executor thread as a fiber, for as long as fibers are used. Idempotent.
+    static bool beginDispatcher();
+    [[nodiscard]] static bool dispatcherReady() noexcept;
+    // Deletes a fiber: now, or when the dispatcher next calls reap() if it is the one running (a thread that exits from
+    // inside its own fiber).
+    static void retire(GuestFiber *fiber);
+    static void reap();
+
+    // The start routine of every fiber (internal).
+    static void run(GuestFiber *fiber);
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+    State m_state = State::Idle;
+    std::function<void()> m_body;
+    std::exception_ptr m_error;
+};
+
+struct GuestFiberDeleter
+{
+    void operator()(GuestFiber *fiber) const { GuestFiber::retire(fiber); }
+};
+
+using GuestFiberRef = std::unique_ptr<GuestFiber, GuestFiberDeleter>;
diff --git a/ps2xRuntime/src/lib/Kernel/GuestFiber.cpp b/ps2xRuntime/src/lib/Kernel/GuestFiber.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/GuestFiber.cpp
@@ -0,0 +1,147 @@
+#include "runtime/ee_fiber.h"
+
+#include <cassert>
+#include <stdexcept>
+#include <vector>
+
+#if defined(_WIN32)
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace
+{
+    // One dispatcher per thread that runs a scheduler (the unit tests run them on whichever thread they are on).
+    thread_local void *t_dispatcher = nullptr;
+    thread_local GuestFiber *t_running = nullptr;
+    thread_local std::vector<GuestFiber *> t_graveyard;
+
+    constexpr SIZE_T kFiberReserve = 1u << 20;
+    constexpr SIZE_T kFiberCommit = 64u << 10;
+
+    VOID CALLBACK fiberStart(PVOID parameter)
+    {
+        GuestFiber::run(static_cast<GuestFiber *>(parameter));
+    }
+}
+
+struct GuestFiber::Impl
+{
+    void *handle = nullptr;
+};
+
+void GuestFiber::run(GuestFiber *fiber)
+{
+    // A fiber never returns from its start routine (that would end the thread): it finishes a body, hands control back
+    // to the dispatcher and waits there for the next one.
+    for (;;)
+    {
+        try
+        {
+            if (fiber->m_body)
+                fiber->m_body();
+        }
+        catch (...)
+        {
+            fiber->m_error = std::current_exception();
+        }
+        fiber->m_body = {};
+        fiber->m_state = State::Finished;
+        SwitchToFiber(t_dispatcher);
+    }
+}
+
+GuestFiber::GuestFiber()
+    : m_impl(std::make_unique<Impl>())
+{
+    m_impl->handle = CreateFiberEx(kFiberCommit, kFiberReserve, FIBER_FLAG_FLOAT_SWITCH, &fiberStart, this);
+    if (m_impl->handle == nullptr)
+        throw std::runtime_error("CreateFiberEx failed");
+}
+
+GuestFiber::~GuestFiber()
+{
+    assert(t_running != this);
+    if (m_impl && m_impl->handle != nullptr)
+        DeleteFiber(m_impl->handle);
+}
+
+bool GuestFiber::beginDispatcher()
+{
+    if (t_dispatcher != nullptr)
+        return true;
+    if (IsThreadAFiber())
+        t_dispatcher = GetCurrentFiber();
+    else
+        t_dispatcher = ConvertThreadToFiberEx(nullptr, FIBER_FLAG_FLOAT_SWITCH);
+    return t_dispatcher != nullptr;
+}
+
+bool GuestFiber::dispatcherReady() noexcept
+{
+    return t_dispatcher != nullptr;
+}
+
+void GuestFiber::switchIn(std::function<void()> body)
+{
+    assert(t_dispatcher != nullptr && t_running == nullptr);
+    assert(m_state == State::Parked || m_state == State::Idle || m_state == State::Finished);
+    if (m_state != State::Parked)
+        m_body = std::move(body);
+    m_state = State::Running;
+    t_running = this;
+    SwitchToFiber(m_impl->handle);
+    t_running = nullptr;
+}
+
+void GuestFiber::switchOut(State state)
+{
+    assert(t_running == this && (state == State::Parked || state == State::Abandoned));
+    m_state = state;
+    SwitchToFiber(t_dispatcher);
+}
+
+void GuestFiber::retire(GuestFiber *fiber)
+{
+    if (fiber == nullptr)
+        return;
+    if (fiber == t_running)
+        t_graveyard.push_back(fiber);
+    else
+        delete fiber;
+}
+
+void GuestFiber::reap()
+{
+    if (t_graveyard.empty())
+        return;
+    std::vector<GuestFiber *> dead;
+    dead.swap(t_graveyard);
+    for (GuestFiber *fiber : dead)
+        retire(fiber);
+}
+
+#else // !_WIN32
+
+struct GuestFiber::Impl
+{
+};
+
+GuestFiber::GuestFiber() = default;
+GuestFiber::~GuestFiber() = default;
+void GuestFiber::run(GuestFiber *) {}
+bool GuestFiber::beginDispatcher() { return false; }
+bool GuestFiber::dispatcherReady() noexcept { return false; }
+void GuestFiber::switchIn(std::function<void()>) {}
+void GuestFiber::switchOut(State) {}
+void GuestFiber::retire(GuestFiber *fiber) { delete fiber; }
+void GuestFiber::reap() {}
+
+#endif
+
+std::exception_ptr GuestFiber::takeError() noexcept
+{
+    std::exception_ptr error = std::move(m_error);
+    m_error = nullptr;
+    return error;
+}
