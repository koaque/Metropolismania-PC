+int32_t PS2Vfs::nextDescriptor() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_nextDescriptor;
+}
+
+void PS2Vfs::closeFrom(int32_t firstDescriptor)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (auto it = m_descriptors.begin(); it != m_descriptors.end();)
+    {
+        if (it->first >= firstDescriptor)
+            it = m_descriptors.erase(it);
+        else
+            ++it;
+    }
+    m_nextDescriptor = firstDescriptor;
+}
