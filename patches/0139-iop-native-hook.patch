+        static void writeCoverageFile(const std::string &path, uint32_t base, const std::vector<uint8_t> &words)
+        {
+            if (path.empty() || words.empty())
+                return;
+            if (std::FILE *file = std::fopen(path.c_str(), "wb"))
+            {
+                const uint32_t header[2] = {base, static_cast<uint32_t>(words.size() * 4u)};
+                std::fwrite(header, sizeof(header), 1, file);
+                std::fwrite(words.data(), 1, words.size(), file);
+                std::fclose(file);
+            }
+        }
