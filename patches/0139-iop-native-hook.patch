+                    log(LogLevel::Error, out.str());
+                }
+            }
+            std::memcpy(ram, ramOriginal.data(), kRamSize);
+            cpu = originalCpu;
+            totalCycles = cyclesAfter;
+            totalInstructions = instructionsAfter;
+        }
