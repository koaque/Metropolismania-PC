+            std::memcpy(ram + kCallStackBase, ramOriginal.data() + kCallStackBase, kCallStackLimit + 0x100u - kCallStackBase);
+            const auto differences = ramDifferences(ramOriginal.data(), ram);
+            if (!differences.empty())
+            {
+                size_t shown = 0;
+                std::string text = "RAM differs in " + std::to_string(differences.size()) + " range(s):";
+                for (const auto &[address, bytes] : differences)
+                {
+                    if (shown++ == 4u)
+                        break;
+                    text += " " + hex(address) + "+" + std::to_string(bytes.size()) + " (replacement " + hex(ram[address]) + ", original " + hex(ramOriginal[address]) + ")";
+                }
+                problems.push_back(text);
+            }
+            ++entry.verified;
+            if (!problems.empty())
+            {
+                ++entry.mismatches;
+                if (entry.mismatches <= 8u)
