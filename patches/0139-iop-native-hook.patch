+            entry.originalInstructions += instructionsAfter - instructionsBefore;
+
+            std::memcpy(ram, ramBefore.data(), kRamSize);
+            cpu = before;
+            replayPosition = 0u;
+            replayProblems.clear();
+            replayActive = true;
+            NativeContextImpl context(*this, cpu);
+            ++nativeDepth;
+            entry.function(context);
+            --nativeDepth;
+            replayActive = false;
+            if (!context.jumped)
+            {
+                cpu.pc = cpu.gpr[31];
+                cpu.branchPending = false;
+            }
+
+            std::vector<std::string> problems = std::move(replayProblems);
+            replayProblems.clear();
+            if (replayPosition != importLog.size())
+                problems.push_back("the replacement made " + std::to_string(replayPosition) + " import call(s), the original " + std::to_string(importLog.size()));
+            const auto hex = [](uint32_t value)
+            {
+                std::ostringstream out;
+                out << "0x" << std::hex << value;
+                return out.str();
+            };
+            static constexpr unsigned kCompared[] = {2, 16, 17, 18, 19, 20, 21, 22, 23, 28, 29, 30, 31};
+            for (const unsigned index : kCompared)
+            {
+                if (index == 2u && !entry.hasResult)
+                    continue;
+                if (cpu.gpr[index] != originalCpu.gpr[index])
+                    problems.push_back("register " + std::to_string(index) + " is " + hex(cpu.gpr[index]) + ", the original left " + hex(originalCpu.gpr[index]));
+            }
+            if (cpu.pc != originalCpu.pc)
