+
+        // The fiber a native function that may block runs on (plan P5). The function's C++ frames are on the fiber's stack: when guest code it
+        // called puts the thread to sleep, the fiber is parked with the frames intact, the scheduler runs other threads, and when the thread is
+        // ready again the scheduler switches back into the fiber, which carries on where the guest code left off. One fiber per IOP thread.
+        struct NativeFiber
+        {
+            Impl *owner = nullptr;
+            void *handle = nullptr;
+            void *returnTo = nullptr; // the host fiber that switched in
+            NativeEntry *entry = nullptr;
+            CpuState *cpu = nullptr;
+            bool parked = false;
+            uint32_t savedNativeDepth = 0u;
+            NativeContext *savedContext = nullptr;
+            std::exception_ptr error;
+        };
+
+        // One import the module's code called while the original ran: arguments, results and the RAM it changed.
+        struct ImportRecord
+        {
+            uint32_t stub = 0;
+            uint32_t sp = 0; // the stack pointer at the call (reported with a difference)
+            uint32_t args[4] = {};
+            uint32_t v0 = 0;
+            uint32_t v1 = 0;
+            std::vector<std::pair<uint32_t, std::vector<uint8_t>>> effects;
+        };
+
+        struct OpenImport
+        {
+            ImportRecord record;
+            uint32_t returnAddress = 0;
+            uint32_t stackPointer = 0;
+            uint64_t instructionsAtOpen = 0;
+            std::vector<uint8_t> before;
+        };
+
+        class NativeContextImpl final : public NativeContext
+        {
+        public:
+            NativeContextImpl(Impl &owner, CpuState &state) : impl(owner), cpu(state) {}
+
+            uint8_t *ram() override { return impl.memory.ramData(); }
+            uint32_t reg(unsigned index) const override { return cpu.gpr[index & 31u]; }
+            void setReg(unsigned index, uint32_t value) override
+            {
+                if ((index & 31u) != 0u)
+                    cpu.gpr[index & 31u] = value;
+            }
+            uint32_t callGuest(uint32_t address, uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3) override
+            {
+                impl.replayArgumentCount = arguments;
+                arguments = 4u;
+                const uint32_t result = impl.callFunction(address, a0, a1, a2, a3, cpu.gpr[28]);
+                impl.replayArgumentCount = 4u;
+                return result;
+            }
+            void argumentCount(unsigned count) override { arguments = count < 4u ? count : 4u; }
+            void stackArguments(const uint32_t *values, unsigned count) override
+            {
+                impl.pendingStackArguments.assign(values, values + count);
+            }
+            void jump(uint32_t address) override
+            {
+                cpu.pc = address;
+                cpu.branchPending = false;
+                jumped = true;
+            }
+            void charge(uint32_t instructions) override
+            {
+                impl.totalInstructions += instructions;
+                impl.totalCycles += instructions;
+            }
+
+            Impl &impl;
+            CpuState &cpu;
+            bool jumped = false;
+            unsigned arguments = 4u;
+        };
+
+        void registerNativeModule(const char *module, uint64_t hash, uint32_t size)
+        {
+            for (auto &spec : nativeModules)
+            {
+                if (iequals(spec.name, module))
+                {
+                    spec.hash = hash;
+                    spec.size = size;
+                    return;
+                }
+            }
+            NativeModuleSpec spec;
+            spec.name = module;
+            spec.hash = hash;
+            spec.size = size;
+            nativeModules.push_back(std::move(spec));
+        }
+
+        void registerNative(const char *module, uint32_t offset, NativeFunction function, const char *name, uint32_t typicalCost, bool hasResult,
+                            uint32_t parkStub, bool mayBlock)
+        {
+            NativeEntry entry;
+            entry.module = module;
+            entry.name = name;
+            entry.offset = offset;
+            entry.function = function;
+            entry.typicalCost = typicalCost;
+            entry.hasResult = hasResult;
+            entry.parkStub = parkStub;
+            entry.mayBlock = mayBlock;
+            natives.push_back(std::move(entry));
+        }
+
+        void registerVerifyIgnore(const char *module, const char *name, uint32_t offset, uint32_t size)
+        {
+            for (auto &entry : natives)
+            {
+                if (iequals(entry.module, module) && entry.name == name)
+                {
+                    entry.verifyIgnore.emplace_back(offset, size);
+                    return;
+                }
+            }
+        }
+
+        // PS2X_IOP_NATIVE: unset or 1 all replacements, 0 none, otherwise a comma separated list of names.
+        // PS2X_IOP_VERIFY=1: the first PS2X_IOP_VERIFY_FIRST calls of each replacement (default 64) and then every PS2X_IOP_VERIFY_EVERY-th (256)
+        // are also run as the original and compared.
+        void configureNatives()
+        {
+            if (const char *value = std::getenv("PS2X_IOP_NATIVE"))
+                nativeSelection = value;
+            if (const char *value = std::getenv("PS2X_IOP_VERIFY"))
+                verifyOn = std::string_view(value) != "0" && *value != '\0';
+            if (const char *value = std::getenv("PS2X_IOP_VERIFY_FIRST"))
+                verifyFirst = std::strtoull(value, nullptr, 10);
+            if (const char *value = std::getenv("PS2X_IOP_VERIFY_EVERY"))
+                verifyEvery = std::strtoull(value, nullptr, 10);
+            if (const char *value = std::getenv("PS2X_IOP_COVERAGE"))
+                coveragePath = value;
+            if (const char *value = std::getenv("PS2X_IOP_PROBE"))
+                probePath = value;
+            if (const char *value = std::getenv("PS2X_IOP_VERIFY_ALL"))
+            {
+                // without a probe script the whole run is verified call by call
+                verifyAllNames = std::string(",") + value + ",";
+                if (probePath.empty())
+                {
+                    verifyAllFrom = 0u;
+                    verifyAllUntil = ~0ull;
+                }
+            }
+            if (const char *value = std::getenv("PS2X_IOP_TRACE_NATIVE"))
+                traceNative = std::string(",") + value + ",";
+            if (const char *value = std::getenv("PS2X_IOP_COVERAGE_ALL"))
+                coverageAllPath = value;
+        }
+
+        bool nativeSelected(const std::string &name) const
+        {
+            if (nativeSelection.empty() || nativeSelection == "1")
+                return true;
+            if (nativeSelection == "0")
+                return false;
+            size_t start = 0;
+            while (start <= nativeSelection.size())
+            {
+                size_t end = nativeSelection.find(',', start);
+                if (end == std::string::npos)
+                    end = nativeSelection.size();
+                if (nativeSelection.compare(start, end - start, name) == 0)
+                    return true;
+                start = end + 1u;
+            }
+            return false;
+        }
+
+        // Called when a module has just been loaded and relocated, before it starts: the replacements of its functions take effect only for the
+        // image they were written against.
+        void armNatives(const Module &module)
+        {
+            // the name a module is loaded by on the disc ends in ";1"
+            std::string moduleName = module.name;
+            if (const size_t version = moduleName.find(';'); version != std::string::npos)
+                moduleName.resize(version);
+            for (auto &spec : nativeModules)
+            {
+                if (!iequals(spec.name, moduleName))
+                    continue;
+                spec.armed = false;
+                uint64_t hash = 14695981039346656037ull;
+                const uint8_t *ram = memory.ramData();
+                if (const char *directory = std::getenv("PS2X_IOP_DUMP_MODULES"))
+                {
+                    // a debug aid: the module as loaded (compare with tools/irx_inspect.py flat)
+                    const std::string file = std::string(directory) + "/" + moduleName + ".ram";
+                    if (std::FILE *out = std::fopen(file.c_str(), "wb"))
+                    {
+                        std::fwrite(ram + module.base, 1, spec.size, out);
+                        std::fclose(out);
+                    }
+                }
+                for (uint32_t i = 0; i < spec.size && module.base + i < kRamSize; ++i)
+                {
+                    hash ^= ram[module.base + i];
+                    hash *= 1099511628211ull;
+                }
+                if (hash != spec.hash)
+                {
+                    std::ostringstream out;
+                    out << "[IOP] native replacements for " << moduleName << " not used: image hash 0x" << std::hex << hash << " differs from the expected 0x"
+                        << spec.hash;
+                    log(LogLevel::Warning, out.str());
+                    return;
+                }
+                spec.base = module.base;
+                spec.armed = true;
+                if (!coverageAllPath.empty())
+                {
+                    allCoverageBase = module.base;
+                    allCoverage.assign(spec.size / 4u, 0u);
+                }
+                uint32_t count = 0;
+                for (auto &entry : natives)
+                {
+                    if (!iequals(entry.module, moduleName) || !nativeSelected(entry.name))
+                        continue;
+                    entry.address = module.base + entry.offset;
+                    entry.armed = true;
+                    nativeAt[entry.address] = &entry;
+                    ++count;
+                }
+                std::ostringstream out;
+                out << "[IOP] " << count << " native replacement(s) armed for " << module.name << " at 0x" << std::hex << module.base
+                    << (verifyOn ? " (PS2X_IOP_VERIFY on)" : "");
+                log(LogLevel::Info, out.str());
+            }
+        }
+
+        void disarmNatives()
+        {
+            nativeAt.clear();
+            for (auto &entry : natives)
+                entry.armed = false;
+            for (auto &spec : nativeModules)
+                spec.armed = false;
+            oracleActive = false;
+            replayActive = false;
+            nativeDepth = 0u;
+        }
+
+        bool inVerifiedModule(uint32_t pc) const
+        {
+            const uint32_t physical = physicalAddress(pc);
+            return physical >= verifyBase && physical < verifyEnd;
+        }
+
+        // The RAM that differs between two images, as (address, bytes of `now`), nearby changes merged.
+        std::vector<std::pair<uint32_t, std::vector<uint8_t>>> ramDifferences(const uint8_t *was, const uint8_t *now) const
+        {
+            std::vector<std::pair<uint32_t, std::vector<uint8_t>>> ranges;
+            constexpr uint32_t kChunk = 4096u;
+            uint32_t i = 0u;
+            while (i < kRamSize)
+            {
+                if (i % kChunk == 0u && std::memcmp(was + i, now + i, kChunk) == 0)
+                {
+                    i += kChunk;
+                    continue;
+                }
+                if (was[i] == now[i])
+                {
+                    ++i;
+                    continue;
+                }
+                uint32_t end = i + 1u;
+                uint32_t gap = 0u;
+                while (end < kRamSize && gap < 16u)
+                {
+                    if (was[end] != now[end])
+                        gap = 0u;
+                    else
+                        ++gap;
+                    ++end;
+                }
+                end -= gap;
+                ranges.emplace_back(i, std::vector<uint8_t>(now + i, now + end));
+                i = end;
+            }
+            return ranges;
+        }
+
+        void finishImport(OpenImport &open, const CpuState &cpu)
+        {
+            open.record.v0 = cpu.gpr[2];
+            open.record.v1 = cpu.gpr[3];
+            open.record.effects = ramDifferences(open.before.data(), memory.ramData());
+            // An import writes words, but a difference only holds the bytes that changed: when the replacement's RAM differs in a byte next to a
+            // changed one (stale stack bytes the original's own frames overwrote, which a replacement does not push), applying only the changed bytes
+            // would leave a different word than the import wrote. So each range grows to whole words, taken as the import left them.
+            {
+                std::vector<std::pair<uint32_t, std::vector<uint8_t>>> widened;
+                for (const auto &[address, bytes] : open.record.effects)
+                {
+                    const uint32_t begin = address & ~3u;
+                    const uint32_t end = std::min<uint32_t>((address + static_cast<uint32_t>(bytes.size()) + 3u) & ~3u, kRamSize);
+                    if (!widened.empty() && widened.back().first + widened.back().second.size() >= begin)
+                    {
+                        auto &last = widened.back();
+                        const uint32_t lastEnd = last.first + static_cast<uint32_t>(last.second.size());
+                        if (end > lastEnd)
+                            last.second.insert(last.second.end(), memory.ramData() + lastEnd, memory.ramData() + end);
+                    }
+                    else
+                    {
+                        widened.emplace_back(begin, std::vector<uint8_t>(memory.ramData() + begin, memory.ramData() + end));
+                    }
+                }
+                open.record.effects = std::move(widened);
+            }
+            oracleImportInstructions += totalInstructions - open.instructionsAtOpen;
+            importLog.push_back(std::move(open.record));
+        }
+
+        // During the native run of a verification: an import of the module is answered from the log of the original's run.
+        void replayImport(CpuState &cpu)
+        {
+            ImportRecord *record = replayPosition < importLog.size() ? &importLog[replayPosition] : nullptr;
+            ++replayPosition;
+            bool sameArguments = record != nullptr && record->stub == cpu.pc;
+            for (unsigned i = 0; sameArguments && i < replayArgumentCount; ++i)
+                sameArguments = record->args[i] == cpu.gpr[4 + i];
+            if (!sameArguments)
+            {
+                std::ostringstream out;
+                out << "import #" << std::dec << (replayPosition - 1u) << " 0x" << std::hex << cpu.pc << "(" << cpu.gpr[4] << "," << cpu.gpr[5] << "," << cpu.gpr[6]
+                    << "," << cpu.gpr[7] << ") sp=" << cpu.gpr[29] << " is not the original's next import";
+                if (debugRamBefore != nullptr && std::getenv("PS2X_IOP_DUMP_IMPORTS") != nullptr)
+                {
+                    // the first argument of each import so far, when it points into the thread's stack: the bytes there before the original ran, after it,
+                    // and now (what the replacement has made of them)
+                    for (size_t k = 0; k + 1u < replayPosition && k < importLog.size(); ++k)
+                    {
+                        const uint32_t where = physicalAddress(importLog[k].args[0]);
+                        if (where < 0x100000u || where + 8u > kRamSize)
+                            continue;
+                        out << " [#" << std::dec << k << std::hex << " at 0x" << where << ": before";
+                        for (unsigned i = 0; i < 8u; ++i)
+                            out << " " << static_cast<unsigned>((*debugRamBefore)[where + i]);
+                        out << " | after";
+                        for (unsigned i = 0; i < 8u; ++i)
+                            out << " " << static_cast<unsigned>((*debugRamAfter)[where + i]);
+                        out << " | now";
+                        for (unsigned i = 0; i < 8u; ++i)
+                            out << " " << static_cast<unsigned>(memory.ramData()[where + i]);
+                        out << "]";
+                    }
+                }
+                if (record != nullptr)
+                    out << " (0x" << record->stub << "(" << record->args[0] << "," << record->args[1] << "," << record->args[2] << "," << record->args[3] << ") sp="
+                        << record->sp << ")";
+                replayProblems.push_back(out.str());
+                cpu.gpr[2] = 0u;
+            }
+            else
+            {
+                for (const auto &[address, bytes] : record->effects)
+                    std::memcpy(memory.ramData() + address, bytes.data(), bytes.size());
+                cpu.gpr[2] = record->v0;
+                cpu.gpr[3] = record->v1;
+            }
+            cpu.pc = cpu.gpr[31];
+            cpu.branchPending = false;
+        }
+
+        // The words of the module the original ran under the verifier: base and size (32 bit, little endian), then one byte per word.
+        void writeCoverage() const
+        {
+            writeCoverageFile(coveragePath, verifyBase, oracleCoverage);
+            writeCoverageFile(coverageAllPath, allCoverageBase, allCoverage);
+        }
+
+        static void writeCoverageFile(const std::string &path, uint32_t base, const std::vector<uint8_t> &words)
+        {
+            if (path.empty() || words.empty())
+                return;
+            if (std::FILE *file = std::fopen(path.c_str(), "wb"))
+            {
+                const uint32_t header[2] = {base, static_cast<uint32_t>(words.size() * 4u)};
+                std::fwrite(header, sizeof(header), 1, file);
+                std::fwrite(words.data(), 1, words.size(), file);
+                std::fclose(file);
+            }
+        }
+
+        void logNativeStats(bool force)
+        {
+            if (!force && totalCycles - lastNativeStatsCycle < 36864000ull * 5u)
+                return;
+            lastNativeStatsCycle = totalCycles;
+            for (const auto &entry : natives)
+            {
+                if (!entry.armed || entry.calls == 0)
+                    continue;
+                std::ostringstream out;
+                out << "[iop:native] " << entry.name << ": " << entry.calls << " call(s)";
+                if (verifyOn)
+                {
+                    out << ", " << entry.verified << " verified, " << entry.mismatches << " mismatch(es), " << entry.unverifiable << " not verifiable";
+                    if (entry.verified != 0)
+                        out << ", the original takes " << (entry.originalInstructions / entry.verified) << " instruction(s) on average ("
+                            << (entry.importInstructions / entry.verified) << " in imports)";
+                }
+                log(LogLevel::Info, out.str());
+            }
+            writeCoverage();
+            if (nativeFiberParks != 0u)
+            {
+                std::ostringstream out;
+                out << "[iop:native] fibers: " << nativeFiberParks << " park(s) of a thread blocked inside a native function";
+                log(LogLevel::Info, out.str());
+            }
+        }
+
+        bool shouldVerify(const NativeEntry &entry) const
+        {
+            if (totalCycles >= verifyAllFrom && totalCycles <= verifyAllUntil &&
+                (verifyAllNames == ",1," || verifyAllNames.find("," + entry.name + ",") != std::string::npos))
+                return true;
+            return entry.calls <= verifyFirst || (verifyEvery != 0u && entry.calls % verifyEvery == 0u);
+        }
+
+        // Called when the IOP reaches the address of an armed replacement.
+        void runNative(NativeEntry &entry, CpuState &cpu)
+        {
+            if (cpu.pendingLoad)
+            {
+                cpu.gpr[cpu.pendingLoadReg] = cpu.pendingLoadValue;
+                cpu.gpr[0] = 0u;
+                cpu.pendingLoad = false;
+            }
+            ++entry.calls;
+            if (!traceNative.empty() && traceNative.find("," + entry.name + ",") != std::string::npos)
+            {
+                std::ostringstream out;
+                out << "[iop:trace] " << entry.name << " #" << entry.calls << std::hex << " a0=" << cpu.gpr[4] << " a1=" << cpu.gpr[5] << " a2=" << cpu.gpr[6]
+                    << " a3=" << cpu.gpr[7] << " data:";
+                const uint32_t pointer = physicalAddress(cpu.gpr[5]);
+                for (uint32_t i = 0; i < 96u && pointer + i < kRamSize; ++i)
+                    out << (i % 16u == 0u ? " | " : " ") << std::setw(2) << std::setfill('0') << static_cast<unsigned>(memory.ramData()[pointer + i]);
+                log(LogLevel::Info, out.str());
+            }
+            if (verifyOn && nativeDepth == 0u && shouldVerify(entry))
+            {
+                verifyNative(entry, cpu);
+                logNativeStats(false);
+                return;
+            }
+            if (entry.mayBlock && runningFiber == nullptr && nativeDepth == 0u && kernel.currentThread() != nullptr &&
+                &cpu == &kernel.currentThread()->cpu && runNativeOnFiber(entry, cpu))
+                return;
+            runNativeBody(entry, cpu);
+        }
+
+        // Makes `inner` the context currentNativeContext() gives, for the life of the scope.
+        struct ContextScope
+        {
+            NativeContext *outer = g_currentNativeContext;
+            explicit ContextScope(NativeContext *inner) { g_currentNativeContext = inner; }
+            ~ContextScope() { g_currentNativeContext = outer; }
+            ContextScope(const ContextScope &) = delete;
+            ContextScope &operator=(const ContextScope &) = delete;
+        };
+
+        // The function itself: runs it and returns to the caller (or leaves the pc where the function jumped to), charging the IOP time.
+        void runNativeBody(NativeEntry &entry, CpuState &cpu)
+        {
+            NativeContextImpl context(*this, cpu);
+            const ContextScope scope(&context);
+            ++nativeDepth;
+            entry.function(context);
+            --nativeDepth;
+            if (!context.jumped)
+            {
+                cpu.pc = cpu.gpr[31];
+                cpu.branchPending = false;
+            }
+            totalInstructions += entry.typicalCost;
+            totalCycles += entry.typicalCost;
+        }
+
+#if defined(_WIN32)
+        static VOID CALLBACK nativeFiberMain(PVOID parameter)
+        {
+            auto *fiber = static_cast<NativeFiber *>(parameter);
+            // a fiber never returns from its start routine: it runs a job, switches back to whoever started it and waits there for the next
+            for (;;)
+            {
+                try
+                {
+                    fiber->owner->runNativeBody(*fiber->entry, *fiber->cpu);
+                }
+                catch (...)
+                {
+                    fiber->error = std::current_exception();
+                }
+                fiber->entry = nullptr;
+                SwitchToFiber(fiber->returnTo);
+            }
+        }
+#endif
+
+        // Runs the native function on the current thread's fiber. False when no fiber could be made (the function then runs on the caller's stack).
+        // Returns when the function has ended or when the thread has gone to sleep inside it: the fiber is then parked, and the thread's own cpu is
+        // marked as yielded so that the slice ends (the kernel already knows the thread is waiting).
+        bool runNativeOnFiber(NativeEntry &entry, CpuState &cpu)
+        {
+#if defined(_WIN32)
+            IopThread *thread = kernel.currentThread();
+            std::unique_ptr<NativeFiber> &slot = nativeFibers[thread->id];
+            if (!slot)
+            {
+                auto fiber = std::make_unique<NativeFiber>();
+                fiber->owner = this;
+                fiber->handle = CreateFiberEx(kNativeFiberCommit, kNativeFiberReserve, FIBER_FLAG_FLOAT_SWITCH, &nativeFiberMain, fiber.get());
+                if (fiber->handle == nullptr)
+                {
+                    nativeFibers.erase(thread->id);
+                    return false;
+                }
+                slot = std::move(fiber);
+            }
+            slot->entry = &entry;
+            slot->cpu = &cpu;
+            switchIntoFiber(*slot);
+            if (slot->parked)
+                cpu.yielded = true;
+            logNativeStats(false);
+            return true;
+#else
+            (void)entry;
+            (void)cpu;
+            return false;
+#endif
+        }
+
+        // Dispatcher side: starts the fiber's job, or goes on with a parked one. Returns when the job has ended or the fiber has parked again.
+        void switchIntoFiber(NativeFiber &fiber)
+        {
+#if defined(_WIN32)
+            if (!IsThreadAFiber())
+                ConvertThreadToFiberEx(nullptr, FIBER_FLAG_FLOAT_SWITCH);
+            fiber.returnTo = GetCurrentFiber();
+            CpuState *const outerActive = activeCpu;
+            NativeFiber *const outerRunning = runningFiber;
+            const uint32_t outerDepth = nativeDepth;
+            NativeContext *const outerContext = g_currentNativeContext;
+            if (fiber.parked)
+            {
+                nativeDepth = fiber.savedNativeDepth;
+                activeCpu = fiber.cpu;
+                g_currentNativeContext = fiber.savedContext;
+            }
+            fiber.parked = false;
+            runningFiber = &fiber;
+            SwitchToFiber(fiber.handle);
+            runningFiber = outerRunning;
+            nativeDepth = outerDepth;
+            activeCpu = outerActive;
+            g_currentNativeContext = outerContext;
+            if (fiber.error)
+            {
+                const std::exception_ptr error = std::move(fiber.error);
+                fiber.error = nullptr;
+                std::rethrow_exception(error);
+            }
+#else
+            (void)fiber;
+#endif
+        }
+
+        // Fiber side: back to the dispatcher with the frames intact; returns when the dispatcher switches in again.
+        void parkRunningFiber()
+        {
+#if defined(_WIN32)
+            NativeFiber &fiber = *runningFiber;
+            fiber.parked = true;
+            fiber.savedNativeDepth = nativeDepth;
+            fiber.savedContext = g_currentNativeContext;
+            ++nativeFiberParks;
+            SwitchToFiber(fiber.returnTo);
+#endif
+        }
+
+        void destroyNativeFibers()
+        {
+#if defined(_WIN32)
+            for (auto &[id, fiber] : nativeFibers)
+            {
+                if (fiber && fiber->handle != nullptr && fiber.get() != runningFiber)
+                    DeleteFiber(fiber->handle);
+            }
+#endif
+            nativeFibers.clear();
+            runningFiber = nullptr;
+        }
