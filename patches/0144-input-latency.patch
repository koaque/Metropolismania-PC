Input lag: the window shows each frame right after the game's vertical blank instead of on raylib's own 60 Hz timer, and host input is read when the game reads its pad. The window loop waits for the scheduler's next vertical blank (EeScheduler::waitForVSyncAfter), polls host events there and presents; a finished frame no longer waits up to a display period for the timer, and 59.94 against 60 no longer beats. On Windows the pad read asks XInput (the first connected slot; empty slots are tried once a second, as Microsoft advises) and the keyboard (GetAsyncKeyState, only while the game's window has focus) at that moment; read this way the keyboard works alongside a pad. Other controllers keep raylib's state, now at most the time since the last vertical blank old. Measured with PS2X_LATENCY_STATS=1 (Metropolismania, menus and a city at about 20 fps): presents went from 25 ms after the vertical blank on average (worst 50 to 65) to 7.2 ms; polled input at the pad read went from 8 to 12 ms old on average (worst about 16) to 0.4 ms in menus and 1.3 ms in the city. PS2X_PRESENT=free and PS2X_HOST_INPUT=polled restore the old behaviour; PS2X_VSYNC=1 asks the host for vsync; PS2X_VSYNC_HZ=host or a rate from 58 to 62 Hz runs the game's vertical blank at the monitor's rate (for fixed 60 Hz displays).

diff --git a/ps2xRuntime/include/runtime/ps2_host_input.h b/ps2xRuntime/include/runtime/ps2_host_input.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_input.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cstdint>
+
+// Host input read at the moment the game asks for its pad, instead of the state from the window's last event poll (which can
+// be a whole display period old). On Windows, XInput pads and the keyboard are read directly (the keyboard only while the
+// game's window has focus, and alongside any pad); other platforms and other controllers keep raylib's state, which the
+// window loop polls at every vertical blank (ps2_pad.cpp, ps2_runtime.cpp).
+
+// PS2 pad buttons, set bits = held (the pad's own order: Select 0x0001 ... Square 0x8000), and the sticks (0x80 = centre).
+struct PS2HostPadState
+{
+    uint16_t held = 0;
+    uint8_t rx = 0x80, ry = 0x80, lx = 0x80, ly = 0x80;
+};
+
+// The first connected XInput pad, read now. False when there is none (or not on Windows).
+bool ps2xHostReadXInputPad(PS2HostPadState &out);
+
+// The keyboard's pad keys (the same keys ps2_pad.cpp maps), read now, while `window` (the game's native window) has focus.
+// False when the keyboard cannot be read this way (not on Windows); `held` is 0 when the window is not in front.
+bool ps2xHostReadKeyboard(void *window, uint16_t &held);
+
+// PS2X_LATENCY_STATS=1: the window loop notes when it polled host events; pad reads record how old their input was.
+void ps2xNoteHostEventPoll();
+void ps2xNotePadRead(bool freshInput);
+// Takes (and resets) the pad read figures: average and worst input age in ms, reads with fresh input and with polled input.
+void ps2xTakePadReadStats(double &averageAgeMs, double &worstAgeMs, uint32_t &freshReads, uint32_t &polledReads);
diff --git a/ps2xRuntime/src/lib/ps2_host_input.cpp b/ps2xRuntime/src/lib/ps2_host_input.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_input.cpp
@@ -0,0 +1,156 @@
+// Host input read when the game reads its pad (see runtime/ps2_host_input.h). Kept apart from ps2_pad.cpp: windows.h and
+// raylib.h cannot share a translation unit.
+
+#include "runtime/ps2_host_input.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+
+#if defined(_WIN32)
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <Xinput.h>
+#pragma comment(lib, "Xinput.lib")
+#endif
+
+namespace
+{
+    constexpr uint16_t kSelect = 0x0001u, kL3 = 0x0002u, kR3 = 0x0004u, kStart = 0x0008u, kUp = 0x0010u, kRight = 0x0020u,
+                       kDown = 0x0040u, kLeft = 0x0080u, kL2 = 0x0100u, kR2 = 0x0200u, kL1 = 0x0400u, kR1 = 0x0800u,
+                       kTriangle = 0x1000u, kCircle = 0x2000u, kCross = 0x4000u, kSquare = 0x8000u;
+
+    std::mutex g_statsMutex;
+    std::chrono::steady_clock::time_point g_lastPoll{};
+    double g_ageSumMs = 0.0, g_ageWorstMs = 0.0;
+    uint32_t g_freshReads = 0, g_polledReads = 0;
+
+#if defined(_WIN32)
+    uint8_t stick(SHORT value, bool invert)
+    {
+        int scaled = 128 + (static_cast<int>(value) * 127) / 32767;
+        if (invert)
+            scaled = 256 - scaled;
+        return static_cast<uint8_t>(std::clamp(scaled, 0, 255));
+    }
+#endif
+}
+
+bool ps2xHostReadXInputPad(PS2HostPadState &out)
+{
+#if defined(_WIN32)
+    // The first connected XInput slot. Microsoft advises against asking about empty slots every frame (each call looks for
+    // a device), so while none is connected the slots are tried once a second.
+    static std::mutex slotMutex;
+    static int slot = -1;
+    static std::chrono::steady_clock::time_point nextScan{};
+    XINPUT_STATE state{};
+    {
+        std::lock_guard<std::mutex> lock(slotMutex);
+        if (slot >= 0 && XInputGetState(static_cast<DWORD>(slot), &state) != ERROR_SUCCESS)
+            slot = -1;
+        if (slot < 0)
+        {
+            const auto now = std::chrono::steady_clock::now();
+            if (now < nextScan)
+                return false;
+            nextScan = now + std::chrono::seconds(1);
+            for (DWORD i = 0; i < XUSER_MAX_COUNT && slot < 0; ++i)
+                if (XInputGetState(i, &state) == ERROR_SUCCESS)
+                    slot = static_cast<int>(i);
+            if (slot < 0)
+                return false;
+        }
+    }
+    const WORD b = state.Gamepad.wButtons;
+    uint16_t held = 0;
+    const struct
+    {
+        WORD xinput;
+        uint16_t pad;
+    } kMap[] = {{XINPUT_GAMEPAD_DPAD_UP, kUp},           {XINPUT_GAMEPAD_DPAD_DOWN, kDown},      {XINPUT_GAMEPAD_DPAD_LEFT, kLeft},
+                {XINPUT_GAMEPAD_DPAD_RIGHT, kRight},     {XINPUT_GAMEPAD_A, kCross},             {XINPUT_GAMEPAD_B, kCircle},
+                {XINPUT_GAMEPAD_X, kSquare},             {XINPUT_GAMEPAD_Y, kTriangle},          {XINPUT_GAMEPAD_LEFT_SHOULDER, kL1},
+                {XINPUT_GAMEPAD_RIGHT_SHOULDER, kR1},    {XINPUT_GAMEPAD_START, kStart},         {XINPUT_GAMEPAD_BACK, kSelect},
+                {XINPUT_GAMEPAD_LEFT_THUMB, kL3},        {XINPUT_GAMEPAD_RIGHT_THUMB, kR3}};
+    for (const auto &m : kMap)
+        if ((b & m.xinput) != 0)
+            held |= m.pad;
+    if (state.Gamepad.bLeftTrigger > XINPUT_GAMEPAD_TRIGGER_THRESHOLD)
+        held |= kL2;
+    if (state.Gamepad.bRightTrigger > XINPUT_GAMEPAD_TRIGGER_THRESHOLD)
+        held |= kR2;
+    out.held = held;
+    // XInput's Y axes point up; the pad's point down.
+    out.lx = stick(state.Gamepad.sThumbLX, false);
+    out.ly = stick(state.Gamepad.sThumbLY, true);
+    out.rx = stick(state.Gamepad.sThumbRX, false);
+    out.ry = stick(state.Gamepad.sThumbRY, true);
+    return true;
+#else
+    (void)out;
+    return false;
+#endif
+}
+
+bool ps2xHostReadKeyboard(void *window, uint16_t &held)
+{
+#if defined(_WIN32)
+    held = 0;
+    if (window == nullptr || GetForegroundWindow() != static_cast<HWND>(window))
+        return true;
+    // The same keys as ps2_pad.cpp's raylib mapping.
+    const struct
+    {
+        int key;
+        uint16_t pad;
+    } kMap[] = {{VK_UP, kUp},       {'W', kUp},          {VK_DOWN, kDown},      {'S', kDown},          {VK_LEFT, kLeft},
+                {'A', kLeft},       {VK_RIGHT, kRight},  {'D', kRight},         {'X', kCross},         {VK_SPACE, kCross},
+                {'C', kCircle},     {VK_ESCAPE, kCircle}, {'Z', kSquare},       {VK_NUMPAD0, kSquare}, {'V', kTriangle},
+                {VK_NUMPAD1, kTriangle}, {'Q', kL1},     {'E', kR1},            {VK_LSHIFT, kL2},      {VK_RSHIFT, kR2},
+                {VK_RETURN, kStart}, {VK_TAB, kSelect}};
+    for (const auto &m : kMap)
+        if ((GetAsyncKeyState(m.key) & 0x8000) != 0)
+            held |= m.pad;
+    return true;
+#else
+    (void)window;
+    held = 0;
+    return false;
+#endif
+}
+
+void ps2xNoteHostEventPoll()
+{
+    std::lock_guard<std::mutex> lock(g_statsMutex);
+    g_lastPoll = std::chrono::steady_clock::now();
+}
+
+void ps2xNotePadRead(bool freshInput)
+{
+    std::lock_guard<std::mutex> lock(g_statsMutex);
+    if (freshInput)
+    {
+        ++g_freshReads;
+        return;
+    }
+    ++g_polledReads;
+    if (g_lastPoll.time_since_epoch().count() == 0)
+        return;
+    const double age = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - g_lastPoll).count();
+    g_ageSumMs += age;
+    g_ageWorstMs = std::max(g_ageWorstMs, age);
+}
+
+void ps2xTakePadReadStats(double &averageAgeMs, double &worstAgeMs, uint32_t &freshReads, uint32_t &polledReads)
+{
+    std::lock_guard<std::mutex> lock(g_statsMutex);
+    averageAgeMs = g_polledReads != 0 ? g_ageSumMs / g_polledReads : 0.0;
+    worstAgeMs = g_ageWorstMs;
+    freshReads = g_freshReads;
+    polledReads = g_polledReads;
+    g_ageSumMs = g_ageWorstMs = 0.0;
+    g_freshReads = g_polledReads = 0;
+}
