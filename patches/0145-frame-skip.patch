+void PS2Runtime::setFrameSkipping(bool skip)
+{
+    m_gs.setSkipDrawing(skip, false);
+}
+
+void PS2Runtime::noteUnwaitedVBlank()
+{
+    if (ps2xFrameSkipUnwaitedVBlank())
+        m_gs.setSkipDrawing(false, true); // the frame that was being skipped stays hidden
+    else if (!ps2xFrameSkipping())
+        m_gs.setSkipDrawing(false, false);
+}
+
+uint64_t PS2Runtime::vu1RunKey(uint32_t startPC)
+{
+    const uint64_t generation = m_memory.getVU1CodeGeneration();
+    if (generation != m_vu1RunEndsGeneration)
+    {
+        // FNV-1a over the code image, once per upload: identical uploads give the same image and keep what was learned.
+        m_vu1RunEndsGeneration = generation;
+        uint64_t hash = 0xCBF29CE484222325ull;
+        const uint8_t *code = m_memory.getVU1Code();
+        for (uint32_t offset = 0; code != nullptr && offset < PS2_VU1_CODE_SIZE; offset += 8u)
+        {
+            uint64_t word = 0;
+            std::memcpy(&word, code + offset, sizeof(word));
+            hash = (hash ^ word) * 0x100000001B3ull;
+        }
+        m_vu1CodeHash = hash;
+        if (m_vu1RunEnds.size() > 4096u)
+            m_vu1RunEnds.clear();
+    }
+    return m_vu1CodeHash + static_cast<uint64_t>(startPC) * 0x9E3779B97F4A7C15ull;
+}
+
+bool PS2Runtime::skipVu1Run(uint32_t startPC, uint32_t top, uint32_t itop)
+{
+    const auto known = m_vu1RunEnds.find(vu1RunKey(startPC));
+    if (known == m_vu1RunEnds.end() || known->second == ~0u)
+    {
+        ps2xFrameSkipNoteVu1Run(false);
+        return false;
+    }
+    VU1State &state = m_vu1.state();
+    state.pc = known->second;
+    state.top = top;
+    state.itop = itop;
+    state.ebit = false;
+    state.haltAfterDelaySlot = false;
+    state.stoppedByD = false;
+    state.stoppedByT = false;
+    state.branchPending = false;
+    ps2xFrameSkipNoteVu1Run(true);
+    return true;
+}
+
+void PS2Runtime::noteVu1RunEnd(uint32_t startPC, bool ended)
+{
+    if (ps2xFrameSkipMode() == FrameSkipMode::Off)
+        return;
+    const uint32_t end = ended && !m_vu1.state().stoppedByD && !m_vu1.state().stoppedByT ? m_vu1.state().pc : ~0u;
+    const auto [entry, inserted] = m_vu1RunEnds.try_emplace(vu1RunKey(startPC), end);
+    if (!inserted && entry->second != end)
+        entry->second = ~0u;
+}
