Frame skip: a game whose logic steps once per frame keeps its speed when the host cannot draw every frame within a field. With PS2X_FRAMESKIP on (or a game's default, ps2xFrameSkipSetDefault), the vertical blanks keep their place in real time instead of starting a new period after a late one, with at most four fields due at once (older ones, from a load or a stall, are dropped). A frame is the span between two waits for the vertical blank; one that starts while the next vertical blank is already due runs without drawing, at most three in a row: VU1 programs are not run (the VU1 is left at the end address the program reached the last time it ran from that address with that code image, so an MSCNT still continues from the right place; a program that has ended in two places, or never run, still runs), and primitives are not drawn, while VIF unpacks, MPG, image transfers, CLUT loads and GS register writes all still happen. The window keeps the last drawn frame while the display points at a buffer a skipped frame did not draw. Two vertical blanks that no thread waited for within one skipped frame end the skip (a movie player that draws from its interrupt handler). PS2X_FRAMESKIP=alternate skips every other frame, for tests; PS2X_FRAMESKIP_STATS=1 prints vertical blanks and frames per second, drawn and skipped frame times, backlog dropped, presents held and VU1 runs skipped. Checked in Metropolismania: native frame buffers at eleven scripted city views are bit-identical with frame skip off, every other frame skipped from boot, and automatic skipping (and two runs without skipping match each other); a 40-capture window burst while skipping never goes back to an earlier picture. The heavy city views went from about 20 to 50-58 game frames per second.

diff --git a/ps2xRuntime/include/runtime/ps2_frame_skip.h b/ps2xRuntime/include/runtime/ps2_frame_skip.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_frame_skip.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdint>
+
+// Frame skip: a game whose logic steps once per frame keeps its speed on a host that cannot draw every frame in a field. The
+// vertical blanks keep their place in real time (a late frame leaves a backlog of at most kMaxBacklogFields fields instead of
+// pushing the next one back), and a frame that starts behind runs without drawing: no VU1 programs and no primitives, while
+// everything else (VIF unpacks, MPG, image transfers, CLUT loads, GS register writes) still happens. The window keeps showing
+// the last drawn frame while the display points at a buffer a skipped frame left undrawn.
+//
+// A frame is the span between two waits for the vertical blank (the moment a thread waiting for one wakes).
+//
+// PS2X_FRAMESKIP=0 turns it off, 1 turns it on, alternate skips every other frame (for testing that nothing drawn later depends
+// on a skipped frame); without it the game's default applies (ps2xFrameSkipSetDefault, off unless a game turns it on).
+// PS2X_FRAMESKIP_STATS=1 prints a [frameskip] line every 2 s (vertical blanks and frames per second, also with frame skip off).
+
+enum class FrameSkipMode
+{
+    Off,
+    Auto,
+    Alternate,
+};
+
+inline constexpr uint32_t kMaxBacklogFields = 4u;
+inline constexpr uint32_t kMaxSkippedInARow = 3u;
+
+void ps2xFrameSkipSetDefault(bool on);
+FrameSkipMode ps2xFrameSkipMode();
+
+// The next `frames` frames are drawn whatever the timing (for example around a screenshot).
+void ps2xFrameSkipSuspend(uint32_t frames);
+
+// At a frame boundary: whether the frame that starts now is skipped. `behind` = the next vertical blank is already due.
+bool ps2xFrameSkipBoundary(bool behind);
+// A vertical blank that no thread waited for. True when it ends a skip: two of them within one skipped frame mean the game is not
+// pacing its frames by waiting for the vertical blank (the movie player draws from its interrupt handler), so drawing resumes.
+bool ps2xFrameSkipUnwaitedVBlank();
+// Whether the current frame is skipped.
+bool ps2xFrameSkipping();
+
+// Statistics for the [frameskip] line.
+void ps2xFrameSkipNoteDroppedTime(uint32_t microseconds);
+void ps2xFrameSkipNoteHeldPresent();
+void ps2xFrameSkipNoteVu1Run(bool skipped);
diff --git a/ps2xRuntime/src/lib/ps2_frame_skip.cpp b/ps2xRuntime/src/lib/ps2_frame_skip.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_frame_skip.cpp
@@ -0,0 +1,154 @@
+// Frame skip state and statistics (see runtime/ps2_frame_skip.h).
+
+#include "runtime/ps2_frame_skip.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+    std::atomic<bool> g_defaultOn{false};
+    std::atomic<bool> g_skipping{false};
+    std::atomic<uint32_t> g_suspended{0};
+    uint32_t g_skippedInARow = 0;
+    uint32_t g_unwaitedVBlanks = 0; // since the last frame boundary
+
+    // [frameskip] figures, reset every 2 s.
+    std::atomic<uint32_t> g_frames{0}, g_skippedFrames{0}, g_droppedMicroseconds{0}, g_heldPresents{0}, g_vu1Skipped{0}, g_vu1Run{0},
+        g_endedSkips{0}, g_vblanks{0};
+    double g_drawnSeconds = 0.0, g_skippedSeconds = 0.0;
+    std::chrono::steady_clock::time_point g_frameStart{};
+
+    const char *setting()
+    {
+        static const char *value = std::getenv("PS2X_FRAMESKIP");
+        return value;
+    }
+
+    bool statsEnabled()
+    {
+        static const bool enabled = []()
+        {
+            const char *value = std::getenv("PS2X_FRAMESKIP_STATS");
+            return value != nullptr && value[0] == '1';
+        }();
+        return enabled;
+    }
+
+    void maybeReport()
+    {
+        static auto windowStart = std::chrono::steady_clock::now();
+        const auto now = std::chrono::steady_clock::now();
+        const double seconds = std::chrono::duration<double>(now - windowStart).count();
+        if (seconds < 2.0)
+            return;
+        windowStart = now;
+        const uint32_t frames = g_frames.exchange(0), skipped = g_skippedFrames.exchange(0);
+        const uint32_t drawn = frames - skipped;
+        // A frame's time runs from its boundary to the next one, its wait for the vertical blank included.
+        std::fprintf(stderr,
+                     "[frameskip] %.2f vertical blanks/s, %.2f frames/s (%u drawn, %.1f ms each; %u skipped, %.1f ms each) | %u "
+                     "ms dropped from the backlog | %u presents held | VU1 runs in skipped frames: %u skipped, %u run | %u skips "
+                     "ended by unwaited vertical blanks\n",
+                     g_vblanks.exchange(0) / seconds, frames / seconds, drawn, drawn != 0u ? g_drawnSeconds * 1000.0 / drawn : 0.0, skipped,
+                     skipped != 0u ? g_skippedSeconds * 1000.0 / skipped : 0.0, g_droppedMicroseconds.exchange(0) / 1000u,
+                     g_heldPresents.exchange(0), g_vu1Skipped.exchange(0), g_vu1Run.exchange(0), g_endedSkips.exchange(0));
+        g_drawnSeconds = g_skippedSeconds = 0.0;
+    }
+}
+
+void ps2xFrameSkipSetDefault(bool on)
+{
+    g_defaultOn.store(on, std::memory_order_relaxed);
+}
+
+FrameSkipMode ps2xFrameSkipMode()
+{
+    const char *value = setting();
+    if (value != nullptr && value[0] != '\0')
+    {
+        if (std::strcmp(value, "alternate") == 0)
+            return FrameSkipMode::Alternate;
+        return std::strcmp(value, "0") == 0 || std::strcmp(value, "off") == 0 ? FrameSkipMode::Off : FrameSkipMode::Auto;
+    }
+    return g_defaultOn.load(std::memory_order_relaxed) ? FrameSkipMode::Auto : FrameSkipMode::Off;
+}
+
+void ps2xFrameSkipSuspend(uint32_t frames)
+{
+    uint32_t current = g_suspended.load(std::memory_order_relaxed);
+    while (current < frames && !g_suspended.compare_exchange_weak(current, frames, std::memory_order_relaxed))
+    {
+    }
+}
+
+bool ps2xFrameSkipBoundary(bool behind)
+{
+    const FrameSkipMode mode = ps2xFrameSkipMode();
+    bool skip = false;
+    if (mode == FrameSkipMode::Alternate)
+        skip = !g_skipping.load(std::memory_order_relaxed);
+    else if (mode == FrameSkipMode::Auto)
+        skip = behind && g_skippedInARow < kMaxSkippedInARow;
+    uint32_t suspended = g_suspended.load(std::memory_order_relaxed);
+    while (suspended != 0u && !g_suspended.compare_exchange_weak(suspended, suspended - 1u, std::memory_order_relaxed))
+    {
+    }
+    if (suspended != 0u)
+        skip = false;
+    g_skippedInARow = skip ? g_skippedInARow + 1u : 0u;
+    g_unwaitedVBlanks = 0;
+    const bool previous = g_skipping.exchange(skip, std::memory_order_acq_rel);
+    if (statsEnabled())
+    {
+        const auto now = std::chrono::steady_clock::now();
+        if (g_frameStart.time_since_epoch().count() != 0)
+            (previous ? g_skippedSeconds : g_drawnSeconds) += std::chrono::duration<double>(now - g_frameStart).count();
+        g_frameStart = now;
+        g_frames.fetch_add(1, std::memory_order_relaxed);
+        g_vblanks.fetch_add(1, std::memory_order_relaxed);
+        if (skip)
+            g_skippedFrames.fetch_add(1, std::memory_order_relaxed);
+        maybeReport();
+    }
+    return skip;
+}
+
+bool ps2xFrameSkipUnwaitedVBlank()
+{
+    ++g_unwaitedVBlanks;
+    if (statsEnabled())
+    {
+        g_vblanks.fetch_add(1, std::memory_order_relaxed);
+        maybeReport();
+    }
+    if (!g_skipping.load(std::memory_order_acquire) || g_unwaitedVBlanks < 2u)
+        return false;
+    g_skipping.store(false, std::memory_order_release);
+    g_skippedInARow = 0;
+    g_endedSkips.fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
+
+bool ps2xFrameSkipping()
+{
+    return g_skipping.load(std::memory_order_acquire);
+}
+
+void ps2xFrameSkipNoteDroppedTime(uint32_t microseconds)
+{
+    g_droppedMicroseconds.fetch_add(microseconds, std::memory_order_relaxed);
+}
+
+void ps2xFrameSkipNoteHeldPresent()
+{
+    g_heldPresents.fetch_add(1, std::memory_order_relaxed);
+}
+
+void ps2xFrameSkipNoteVu1Run(bool skipped)
+{
+    (skipped ? g_vu1Skipped : g_vu1Run).fetch_add(1, std::memory_order_relaxed);
+}
