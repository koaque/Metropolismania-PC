+void GSCpuBackend::WritePixel(const GSDrawState &state, int x, int y, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+{
+    const auto &ctx = state.context;
+    if (x < ctx.scissor.x0 || x > ctx.scissor.x1 || y < ctx.scissor.y0 || y > ctx.scissor.y1)
+        return;
+
+    if (!t_inProbe && pixelProbe().on && x == pixelProbe().x && y == pixelProbe().y &&
+        std::chrono::steady_clock::now() - pixelProbe().start >= std::chrono::seconds(pixelProbe().seconds))
+    {
+        const uint32_t hit = g_probeHits.fetch_add(1u, std::memory_order_relaxed);
+        if (hit >= pixelProbe().skip && hit < pixelProbe().skip + pixelProbe().count)
+        {
+            const u32 pbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+            const u32 pbw = std::max<u32>(ctx.frame.fbw, 1u);
+            const u32 before = ReadVramUnlocked(ctx.frame.psm, pbp, pbw, x, y);
+            t_inProbe = true;
+            WritePixel(state, x, y, z, r, g, b, a, fog);
+            t_inProbe = false;
+            const u32 after = ReadVramUnlocked(ctx.frame.psm, pbp, pbw, x, y);
+            const auto &t = ctx.tex0;
+            std::lock_guard<std::mutex> lock(g_probeMutex);
+            std::fprintf(stderr,
+                         "[gs:probe] #%u fbp=0x%x psm=0x%x prim=%u tme=%d abe=%d fge=%d iip=%d fst=%d | tex psm=0x%x tbp=0x%x tfx=%u tcc=%u "
+                         "cpsm=0x%x csm=%u csa=%u linear=%d | alpha=0x%llx pabe=%d fba=0x%llx test=0x%llx texa(ta0=0x%x ta1=0x%x aem=%d) "
+                         "colclamp=0x%llx dthe=0x%llx fbmsk=0x%x | in rgba=%02x%02x%02x%02x fog=%u z=0x%x | before=0x%08x after=0x%08x\n",
+                         hit, ctx.frame.fbp, ctx.frame.psm, static_cast<unsigned>(state.prim.type), state.prim.tme, state.prim.abe,
+                         state.prim.fge, state.prim.iip, state.prim.fst, t.psm, t.tbp0, t.tfx, t.tcc, t.cpsm, t.csm, t.csa, state.linearFilter,
+                         static_cast<unsigned long long>(ctx.alpha), state.pabe, static_cast<unsigned long long>(ctx.fba),
+                         static_cast<unsigned long long>(ctx.test), state.texa.ta0, state.texa.ta1, state.texa.aem,
+                         static_cast<unsigned long long>(state.colclamp), static_cast<unsigned long long>(state.dthe), ctx.frame.fbmsk, r, g,
+                         b, a, fog, static_cast<u32>(z), before, after);
+            return;
+        }
+    }
+
+    writePixelCore(makePixelPipe(m_vram, state), x, y, z, r, g, b, a, fog);
+}
+
+uint32_t GSCpuBackend::LookupCLUT(const GSDrawState &state,
+                                  uint8_t index,
+                                  uint8_t cpsm,
+                                  uint8_t csm,
+                                  uint8_t csa,
+                                  uint8_t sourcePsm)
+{
+    return lookupClutInline(state.texa, clutTable(), index, cpsm, csm, csa, sourcePsm);
+}
