+    // PS2X_VIF1_UNPACK_VERIFY=1 runs the general UNPACK loop after the plain one on the same memory and compares what they wrote.
+    bool unpackVerifyEnabled()
+    {
+        static const bool enabled = []()
+        {
+            const char *value = std::getenv("PS2X_VIF1_UNPACK_VERIFY");
+            return value != nullptr && value[0] == '1';
+        }();
+        return enabled;
+    }
+
+    static_assert(PS2_VU1_DATA_SIZE == 0x4000u, "plain UNPACK wraps destinations at 1024 quadwords");
+
+    template <uint32_t Bits>
+    inline uint32_t unpackComponent(const uint8_t *src, uint32_t c, bool zeroExtend)
+    {
+        if constexpr (Bits == 32u)
+        {
+            uint32_t value;
+            std::memcpy(&value, src + c * 4u, sizeof(value));
+            return value;
+        }
+        else if constexpr (Bits == 16u)
+        {
+            uint16_t raw;
+            std::memcpy(&raw, src + c * 2u, sizeof(raw));
+            return zeroExtend ? static_cast<uint32_t>(raw) : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(raw)));
+        }
+        else
+        {
+            const uint8_t raw = src[c];
+            return zeroExtend ? static_cast<uint32_t>(raw) : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(raw)));
+        }
+    }
+
+    // An UNPACK without mask or row addition, with CL >= WL and a format of 8, 16 or 32 bits per component: what the general
+    // loop in processVIF1Data writes for it, vector by vector in the same order (S broadcasts, V2 writes x y x y, V3 keeps w).
+    template <uint32_t Components, uint32_t Bits>
+    void unpackPlain(uint8_t *vu1Data, const uint8_t *src, uint32_t writeCount, uint32_t vuAddr, uint32_t cl, uint32_t wl,
+                     bool zeroExtend)
+    {
+        constexpr uint32_t bytesPerVector = Components * Bits / 8u;
+        uint32_t block = 0u, cyclePos = 0u;
+        for (uint32_t i = 0u; i < writeCount; ++i, src += bytesPerVector)
+        {
+            uint8_t *dest = vu1Data + (((vuAddr + block + cyclePos) & 0x3FFu) << 4);
+            if (++cyclePos == wl)
+            {
+                cyclePos = 0u;
+                block += cl;
+            }
+            if constexpr (Bits == 32u && Components >= 3u)
+            {
+                std::memcpy(dest, src, bytesPerVector);
+            }
+            else
+            {
+                uint32_t lanes[4];
+                if constexpr (Components == 1u)
+                {
+                    lanes[0] = lanes[1] = lanes[2] = lanes[3] = unpackComponent<Bits>(src, 0u, zeroExtend);
+                }
+                else if constexpr (Components == 2u)
+                {
+                    lanes[0] = lanes[2] = unpackComponent<Bits>(src, 0u, zeroExtend);
+                    lanes[1] = lanes[3] = unpackComponent<Bits>(src, 1u, zeroExtend);
+                }
+                else
+                {
+                    for (uint32_t c = 0u; c < 3u; ++c)
+                        lanes[c] = unpackComponent<Bits>(src, c, zeroExtend);
+                    if constexpr (Components == 4u)
+                        lanes[3] = unpackComponent<Bits>(src, 3u, zeroExtend);
+                    else
+                        std::memcpy(&lanes[3], dest + 12, sizeof(lanes[3]));
+                }
+                std::memcpy(dest, lanes, sizeof(lanes));
+            }
+        }
+    }
+
+    template <uint32_t Bits>
+    void unpackPlainBits(uint32_t components, uint8_t *vu1Data, const uint8_t *src, uint32_t writeCount, uint32_t vuAddr,
+                         uint32_t cl, uint32_t wl, bool zeroExtend)
+    {
+        switch (components)
+        {
+        case 1u:
+            unpackPlain<1u, Bits>(vu1Data, src, writeCount, vuAddr, cl, wl, zeroExtend);
+            break;
+        case 2u:
+            unpackPlain<2u, Bits>(vu1Data, src, writeCount, vuAddr, cl, wl, zeroExtend);
+            break;
+        case 3u:
+            unpackPlain<3u, Bits>(vu1Data, src, writeCount, vuAddr, cl, wl, zeroExtend);
+            break;
+        default:
+            unpackPlain<4u, Bits>(vu1Data, src, writeCount, vuAddr, cl, wl, zeroExtend);
+            break;
+        }
+    }
 }
 
