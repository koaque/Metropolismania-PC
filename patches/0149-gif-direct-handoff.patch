+++ b/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp
@@ -32,6 +32,21 @@ void GifArbiter::submit(GifPathId pathId, const uint8_t *data, uint32_t sizeByte
     m_queue.push_back(std::move(pkt));
 }
 
+void GifArbiter::submitAndDrain(GifPathId pathId, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl)
+{
+    if (!m_queue.empty())
+    {
+        submit(pathId, data, sizeBytes, path2DirectHl);
+        drain();
+        return;
+    }
+    if (!data || sizeBytes < 16 || !m_processFn)
+        return;
+    // As if queued alone and drained: anything submitted while it is processed comes after it.
+    m_processFn(data, sizeBytes);
+    drain();
+}
