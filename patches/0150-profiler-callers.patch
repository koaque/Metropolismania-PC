+            for (const auto &[tid, byPair] : callers)
+            {
+                uint32_t total = 0;
+                if (auto it = samples.find(tid); it != samples.end())
+                    for (const auto &[address, count] : it->second)
+                        total += count;
+                if (total < 200)
+                    continue;
+                std::map<std::string, uint32_t> byName;
+                for (const auto &[pair, count] : byPair)
+                    byName[symbolFor(process, pair.first) + " <- " + symbolFor(process, pair.second)] += count;
+                std::vector<std::pair<std::string, uint32_t>> sorted(byName.begin(), byName.end());
+                std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b)
+                          { return a.second > b.second; });
+                std::cerr << "[profile:callers] thread " << tid << " samples=" << total << std::endl;
+                for (size_t i = 0; i < sorted.size() && i < 30; ++i)
+                    std::cerr << "[profile:callers]   " << (100.0 * sorted[i].second / total) << "% " << sorted[i].first << std::endl;
+            }
+        }
