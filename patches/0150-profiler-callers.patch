+        // The first return addresses inside the executable above a suspended thread's frame, into chain[1] to chain[4] (x64
+        // unwind data; a function without any is a leaf with its return address at RSP). chain[1] stays 0 when none is found
+        // within a few frames.
+        template <typename InExe>
+        static void unwindIntoExe(CONTEXT context, const InExe &inExe, Chain &chain)
+        {
+            size_t found = 1;
+            for (int depth = 0; depth < 16 && found < chain.size(); ++depth)
+            {
+                DWORD64 imageBase = 0;
+                PRUNTIME_FUNCTION function = RtlLookupFunctionEntry(context.Rip, &imageBase, nullptr);
