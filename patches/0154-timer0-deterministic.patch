+    // PS2X_TIMER0=frame: the guest's reads of timer 0's count no longer depend on emulated time. A game that takes the count
+    // as a random number (Metropolismania does, for people's destinations and sound noise) then makes the same choices however
+    // long its code takes to run, so two runs with different code (a native port, a native renderer) can be compared state for
+    // state. Each read returns a hash of how many times the count has been written (games reset it once a frame) and of the
+    // read's place since that write, in 0x100 to 0x10FF: small enough that a frame-load figure computed from it stays low. The
+    // timer itself keeps counting as before (its interrupts and compare matches are unchanged); only what a read returns differs.
+    // PS2X_TIMER0_TRACE=1 also prints, at each write of the count, how many reads the guest made since the one before, so two
+    // runs can be checked for reading the count the same number of times each frame.
+    struct DeterministicTimer0
+    {
+        bool on = false;
+        bool trace = false;
+        uint32_t writes = 0u;
+        uint32_t reads = 0u;
+    };
+
+    DeterministicTimer0 &deterministicTimer0()
+    {
+        static DeterministicTimer0 state = []
+        {
+            DeterministicTimer0 initial;
+            const char *value = std::getenv("PS2X_TIMER0");
+            initial.on = value != nullptr && std::strcmp(value, "frame") == 0;
+            const char *trace = std::getenv("PS2X_TIMER0_TRACE");
+            initial.trace = trace != nullptr && std::strcmp(trace, "1") == 0;
+            return initial;
+        }();
+        return state;
+    }
+
+    uint32_t deterministicTimer0Count(uint32_t writes, uint32_t reads)
+    {
+        uint32_t x = writes * 0x9E3779B1u ^ (reads + 1u) * 0x85EBCA77u;
+        x ^= x >> 15;
+        x *= 0x2C1B3C6Du;
+        x ^= x >> 12;
+        x *= 0x297A2D39u;
+        x ^= x >> 15;
+        return 0x100u + (x & 0x0FFFu);
+    }
+
