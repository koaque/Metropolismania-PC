diff --git a/ps2xRuntime/include/runtime/ps2_host.h b/ps2xRuntime/include/runtime/ps2_host.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host.h
@@ -0,0 +1,89 @@
+#pragma once
+
+// The desktop host: window, GPU device and presentation, keyboard and gamepads, audio output. SDL3 underneath (SDL's GPU API,
+// which runs on Direct3D 12 or Vulkan on Windows and on Metal on macOS). One host per process; everything here is called from
+// the window thread (run()'s loop) unless a function says otherwise.
+
+#include <cstdint>
+
+struct SDL_Window;
+struct SDL_GPUDevice;
+struct SDL_GPUCommandBuffer;
+struct SDL_GPURenderPass;
+struct SDL_GPUTexture;
+union SDL_Event;
+
+namespace ps2x::host
+{
+    struct WindowOptions
+    {
+        const char *title = "PS2";
+        int width = 640;
+        int height = 480;
+        bool headless = false;   // no window shown, no GPU device, no audio (tools that run the game without playing it)
+        bool place = false;      // open at (x, y) without taking focus
+        int x = 0;
+        int y = 0;
+        bool waitForMonitor = false; // present with vsync (FIFO) instead of at once
+    };
+
+    // Creates the window and the GPU device (PS2X_GPU=d3d12|vulkan|metal picks the backend; SDL's choice otherwise).
+    bool init(const WindowOptions &options);
+    void shutdown();
+    bool windowReady();
+    bool headless();
+
+    SDL_Window *window();
+    SDL_GPUDevice *device();
+    // The window's native handle (HWND on Windows), or null.
+    void *nativeWindowHandle();
+    // The refresh rate of the monitor the window is on, 0 when unknown.
+    float monitorRefreshRate();
+
+    // Processes pending window and input events. Returns false once the window was asked to close.
+    bool pollEvents();
+    bool closeRequested();
+
+    // A function that sees every event first (the debug UI); it returns true to keep the event from the game's input.
+    using EventHook = bool (*)(void *user, const SDL_Event *event);
+    void setEventHook(EventHook hook, void *user);
+
+    // The frame to show: RGBA8, `width` x `height` pixels, rows of `stride` bytes. Copied; the GPU upload happens at present().
+    void setFrame(const uint8_t *rgba, uint32_t width, uint32_t height, uint32_t stride);
+
+    // Drawing over the frame (the debug UI) or in its place (a native renderer). `prepare` runs before any render pass (uploads),
+    // `draw` inside a pass on the swapchain image after the frame was put there. A replacement draws the whole swapchain image
+    // itself and the frame is not blitted.
+    struct Overlay
+    {
+        void (*prepare)(void *user, SDL_GPUCommandBuffer *commands) = nullptr;
+        void (*draw)(void *user, SDL_GPUCommandBuffer *commands, SDL_GPURenderPass *pass) = nullptr;
+        void *user = nullptr;
+    };
+    void setOverlay(const Overlay &overlay);
+    using Replacement = void (*)(void *user, SDL_GPUCommandBuffer *commands, SDL_GPUTexture *swapchain, uint32_t width,
+                                 uint32_t height);
+    void setReplacement(Replacement replacement, void *user);
+
+    // Shows the frame: the part (0, 0, sourceWidth, sourceHeight) of the last setFrame() scaled to fill (x, y, w, h) of the
+    // window's drawable area with nearest sampling, the rest black, then the overlay. Waits for a swapchain image (with vsync
+    // on, for the monitor). Does nothing while the window is minimized.
+    void present(float sourceWidth, float sourceHeight, float x, float y, float w, float h);
+    // The window's drawable size in pixels.
+    void drawableSize(int &width, int &height);
+
+    // Keyboard state by SDL scancode, and whether a key went down since the previous pollEvents().
+    bool keyDown(int scancode);
+    bool keyPressed(int scancode);
+
+    // Gamepads in the order they were connected (any pad SDL knows: XInput, DualShock, DualSense, Switch, ...).
+    int gamepadCount();
+    bool gamepadButton(int index, int sdlButton);
+    float gamepadAxis(int index, int sdlAxis); // -1..1 for sticks, 0..1 for triggers
+
+    // Audio output: `callback` is called from SDL's audio thread to fill `frames` stereo 16-bit frames at `rate`.
+    using AudioCallback = void (*)(int16_t *samples, uint32_t frames);
+    bool openAudio(int rate, AudioCallback callback);
+    void closeAudio();
+    bool audioReady();
+}
diff --git a/ps2xRuntime/include/runtime/ps2_host_compat.h b/ps2xRuntime/include/runtime/ps2_host_compat.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_compat.h
@@ -0,0 +1,106 @@
+#pragma once
+
+// The few raylib names the runtime's pad and audio code was written against, kept so that code reads as before, now answered
+// by the SDL3 host (runtime/ps2_host.h): key and gamepad state, the window's state, and short sounds played from WAV data.
+
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_scancode.h>
+
+#include <cstdint>
+
+// Keys, as SDL scancodes.
+enum : int
+{
+    KEY_A = SDL_SCANCODE_A,
+    KEY_C = SDL_SCANCODE_C,
+    KEY_D = SDL_SCANCODE_D,
+    KEY_E = SDL_SCANCODE_E,
+    KEY_Q = SDL_SCANCODE_Q,
+    KEY_S = SDL_SCANCODE_S,
+    KEY_V = SDL_SCANCODE_V,
+    KEY_W = SDL_SCANCODE_W,
+    KEY_X = SDL_SCANCODE_X,
+    KEY_Z = SDL_SCANCODE_Z,
+    KEY_ONE = SDL_SCANCODE_1,
+    KEY_THREE = SDL_SCANCODE_3,
+    KEY_UP = SDL_SCANCODE_UP,
+    KEY_DOWN = SDL_SCANCODE_DOWN,
+    KEY_LEFT = SDL_SCANCODE_LEFT,
+    KEY_RIGHT = SDL_SCANCODE_RIGHT,
+    KEY_ENTER = SDL_SCANCODE_RETURN,
+    KEY_ESCAPE = SDL_SCANCODE_ESCAPE,
+    KEY_SPACE = SDL_SCANCODE_SPACE,
+    KEY_TAB = SDL_SCANCODE_TAB,
+    KEY_LEFT_SHIFT = SDL_SCANCODE_LSHIFT,
+    KEY_RIGHT_SHIFT = SDL_SCANCODE_RSHIFT,
+    KEY_LEFT_CONTROL = SDL_SCANCODE_LCTRL,
+    KEY_RIGHT_CONTROL = SDL_SCANCODE_RCTRL,
+    KEY_KP_0 = SDL_SCANCODE_KP_0,
+    KEY_KP_1 = SDL_SCANCODE_KP_1,
+    KEY_F1 = SDL_SCANCODE_F1,
+};
+
+// Gamepad buttons, as SDL gamepad buttons (positions: south is Cross on a PlayStation pad, A on an Xbox pad). The two
+// triggers are axes in SDL; they read as buttons past half way.
+enum : int
+{
+    GAMEPAD_BUTTON_LEFT_FACE_UP = SDL_GAMEPAD_BUTTON_DPAD_UP,
+    GAMEPAD_BUTTON_LEFT_FACE_DOWN = SDL_GAMEPAD_BUTTON_DPAD_DOWN,
+    GAMEPAD_BUTTON_LEFT_FACE_LEFT = SDL_GAMEPAD_BUTTON_DPAD_LEFT,
+    GAMEPAD_BUTTON_LEFT_FACE_RIGHT = SDL_GAMEPAD_BUTTON_DPAD_RIGHT,
+    GAMEPAD_BUTTON_RIGHT_FACE_DOWN = SDL_GAMEPAD_BUTTON_SOUTH,
+    GAMEPAD_BUTTON_RIGHT_FACE_RIGHT = SDL_GAMEPAD_BUTTON_EAST,
+    GAMEPAD_BUTTON_RIGHT_FACE_LEFT = SDL_GAMEPAD_BUTTON_WEST,
+    GAMEPAD_BUTTON_RIGHT_FACE_UP = SDL_GAMEPAD_BUTTON_NORTH,
+    GAMEPAD_BUTTON_LEFT_TRIGGER_1 = SDL_GAMEPAD_BUTTON_LEFT_SHOULDER,
+    GAMEPAD_BUTTON_RIGHT_TRIGGER_1 = SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER,
+    GAMEPAD_BUTTON_MIDDLE_LEFT = SDL_GAMEPAD_BUTTON_BACK,
+    GAMEPAD_BUTTON_MIDDLE_RIGHT = SDL_GAMEPAD_BUTTON_START,
+    GAMEPAD_BUTTON_LEFT_THUMB = SDL_GAMEPAD_BUTTON_LEFT_STICK,
+    GAMEPAD_BUTTON_RIGHT_THUMB = SDL_GAMEPAD_BUTTON_RIGHT_STICK,
+    GAMEPAD_BUTTON_LEFT_TRIGGER_2 = 1000 + SDL_GAMEPAD_AXIS_LEFT_TRIGGER,
+    GAMEPAD_BUTTON_RIGHT_TRIGGER_2 = 1000 + SDL_GAMEPAD_AXIS_RIGHT_TRIGGER,
+};
+
+enum : int
+{
+    GAMEPAD_AXIS_LEFT_X = SDL_GAMEPAD_AXIS_LEFTX,
+    GAMEPAD_AXIS_LEFT_Y = SDL_GAMEPAD_AXIS_LEFTY,
+    GAMEPAD_AXIS_RIGHT_X = SDL_GAMEPAD_AXIS_RIGHTX,
+    GAMEPAD_AXIS_RIGHT_Y = SDL_GAMEPAD_AXIS_RIGHTY,
+};
+
+bool IsKeyDown(int key);
+bool IsKeyPressed(int key);
+bool IsGamepadAvailable(int gamepad);
+bool IsGamepadButtonDown(int gamepad, int button);
+float GetGamepadAxisMovement(int gamepad, int axis);
+bool IsWindowReady();
+void *GetWindowHandle();
+bool IsAudioDeviceReady();
+
+// Short sounds: a WAV file in memory, played on the default output device.
+struct Wave
+{
+    unsigned int frameCount = 0; // sample frames (one sample per channel)
+    void *data = nullptr;
+    uint32_t size = 0;
+    int format = 0;
+    int channels = 0;
+    int rate = 0;
+};
+
+struct Sound
+{
+    void *stream = nullptr; // SDL_AudioStream
+};
+
+Wave LoadWaveFromMemory(const char *fileType, const unsigned char *data, int size);
+void UnloadWave(Wave wave);
+Sound LoadSoundFromWave(Wave wave);
+void UnloadSound(Sound sound);
+void PlaySound(Sound sound);
+void StopSound(Sound sound);
+bool IsSoundPlaying(Sound sound);
+void SetSoundPitch(Sound sound, float pitch);
+void SetSoundVolume(Sound sound, float volume);
diff --git a/ps2xRuntime/src/lib/ps2_host_sdl.cpp b/ps2xRuntime/src/lib/ps2_host_sdl.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_host_sdl.cpp
@@ -0,0 +1,595 @@
+// The desktop host on SDL3: window, GPU device and presentation (SDL's GPU API), keyboard and gamepads, audio output.
+// See runtime/ps2_host.h.
+
+#include "runtime/ps2_host.h"
+#include "runtime/ps2_host_compat.h"
+
+#include <SDL3/SDL.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <mutex>
+#include <vector>
+
+namespace ps2x::host
+{
+    namespace
+    {
+        struct State
+        {
+            SDL_Window *window = nullptr;
+            SDL_GPUDevice *device = nullptr;
+            bool headless = false;
+            bool closeRequested = false;
+
+            EventHook eventHook = nullptr;
+            void *eventUser = nullptr;
+            Overlay overlay;
+            Replacement replacement = nullptr;
+            void *replacementUser = nullptr;
+
+            std::mutex frameMutex; // setFrame may come from another thread than present
+            std::vector<uint8_t> frame;
+            uint32_t frameWidth = 0;
+            uint32_t frameHeight = 0;
+            bool frameDirty = false;
+            SDL_GPUTexture *frameTexture = nullptr;
+            uint32_t textureWidth = 0;
+            uint32_t textureHeight = 0;
+            SDL_GPUTransferBuffer *upload = nullptr;
+            uint32_t uploadSize = 0;
+
+            // Keyboard: written by the window thread, read by the game thread at its pad read.
+            std::array<std::atomic<uint8_t>, SDL_SCANCODE_COUNT> keysNow{};
+            std::array<uint8_t, SDL_SCANCODE_COUNT> keysBefore{};
+
+            std::mutex padMutex;
+            std::vector<SDL_Gamepad *> pads;
+
+            SDL_AudioStream *audio = nullptr;
+            AudioCallback audioCallback = nullptr;
+            std::vector<int16_t> audioScratch;
+        };
+
+        State &state()
+        {
+            static State s;
+            return s;
+        }
+
+        const char *backendName()
+        {
+            const char *value = std::getenv("PS2X_GPU");
+            if (value == nullptr || *value == '\0')
+                return nullptr;
+            if (std::strcmp(value, "d3d12") == 0)
+                return "direct3d12";
+            return value; // "vulkan", "metal", or SDL's own names
+        }
+
+        const char *presentModeName(SDL_GPUPresentMode mode)
+        {
+            switch (mode)
+            {
+            case SDL_GPU_PRESENTMODE_VSYNC:
+                return "vsync";
+            case SDL_GPU_PRESENTMODE_IMMEDIATE:
+                return "immediate";
+            case SDL_GPU_PRESENTMODE_MAILBOX:
+                return "mailbox";
+            }
+            return "?";
+        }
+
+        void SDLCALL feedAudio(void *, SDL_AudioStream *stream, int additional, int)
+        {
+            State &s = state();
+            if (s.audioCallback == nullptr || additional <= 0)
+                return;
+            const uint32_t frames = static_cast<uint32_t>(additional) / 4u;
+            if (frames == 0u)
+                return;
+            s.audioScratch.resize(static_cast<size_t>(frames) * 2u);
+            s.audioCallback(s.audioScratch.data(), frames);
+            SDL_PutAudioStreamData(stream, s.audioScratch.data(), static_cast<int>(frames * 4u));
+        }
+
+        bool ensureFrameTexture(State &s, uint32_t width, uint32_t height)
+        {
+            if (s.frameTexture != nullptr && s.textureWidth == width && s.textureHeight == height)
+                return true;
+            if (s.frameTexture != nullptr)
+                SDL_ReleaseGPUTexture(s.device, s.frameTexture);
+            SDL_GPUTextureCreateInfo info{};
+            info.type = SDL_GPU_TEXTURETYPE_2D;
+            info.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+            info.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER;
+            info.width = width;
+            info.height = height;
+            info.layer_count_or_depth = 1;
+            info.num_levels = 1;
+            s.frameTexture = SDL_CreateGPUTexture(s.device, &info);
+            s.textureWidth = s.frameTexture != nullptr ? width : 0u;
+            s.textureHeight = s.frameTexture != nullptr ? height : 0u;
+            return s.frameTexture != nullptr;
+        }
+
+        // Copies the pending frame into the GPU texture (a copy pass on `commands`).
+        void uploadFrame(State &s, SDL_GPUCommandBuffer *commands)
+        {
+            std::lock_guard<std::mutex> lock(s.frameMutex);
+            if (!s.frameDirty || s.frameWidth == 0u || s.frameHeight == 0u)
+                return;
+            s.frameDirty = false;
+            if (!ensureFrameTexture(s, s.frameWidth, s.frameHeight))
+                return;
+            const uint32_t bytes = s.frameWidth * s.frameHeight * 4u;
+            if (s.upload == nullptr || s.uploadSize < bytes)
+            {
+                if (s.upload != nullptr)
+                    SDL_ReleaseGPUTransferBuffer(s.device, s.upload);
+                SDL_GPUTransferBufferCreateInfo info{};
+                info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD;
+                info.size = bytes;
+                s.upload = SDL_CreateGPUTransferBuffer(s.device, &info);
+                s.uploadSize = s.upload != nullptr ? bytes : 0u;
+                if (s.upload == nullptr)
+                    return;
+            }
+            void *mapped = SDL_MapGPUTransferBuffer(s.device, s.upload, true);
+            if (mapped == nullptr)
+                return;
+            std::memcpy(mapped, s.frame.data(), bytes);
+            SDL_UnmapGPUTransferBuffer(s.device, s.upload);
+
+            SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(commands);
+            SDL_GPUTextureTransferInfo source{};
+            source.transfer_buffer = s.upload;
+            source.pixels_per_row = s.frameWidth;
+            source.rows_per_layer = s.frameHeight;
+            SDL_GPUTextureRegion destination{};
+            destination.texture = s.frameTexture;
+            destination.w = s.frameWidth;
+            destination.h = s.frameHeight;
+            destination.d = 1;
+            SDL_UploadToGPUTexture(copy, &source, &destination, true);
+            SDL_EndGPUCopyPass(copy);
+        }
+    }
+
+    bool init(const WindowOptions &options)
+    {
+        State &s = state();
+        s.headless = options.headless;
+        // Pads keep working while the window is in the background (test runs are shown unfocused).
+        SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+        SDL_SetHint(SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES, "1024");
+        if (options.place)
+            SDL_SetHint(SDL_HINT_WINDOW_ACTIVATE_WHEN_SHOWN, "0");
+        const SDL_InitFlags flags = options.headless ? SDL_INIT_EVENTS : (SDL_INIT_VIDEO | SDL_INIT_EVENTS | SDL_INIT_AUDIO | SDL_INIT_GAMEPAD);
+        if (!SDL_Init(flags))
+        {
+            std::cerr << "[host] SDL_Init failed: " << SDL_GetError() << std::endl;
+            return false;
+        }
+        if (options.headless)
+            return true;
+
+        s.window = SDL_CreateWindow(options.title, options.width, options.height, SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIDDEN);
+        if (s.window == nullptr)
+        {
+            std::cerr << "[host] SDL_CreateWindow failed: " << SDL_GetError() << std::endl;
+            return false;
+        }
+        if (options.place)
+            SDL_SetWindowPosition(s.window, options.x, options.y);
+
+        s.device = SDL_CreateGPUDevice(SDL_GPU_SHADERFORMAT_SPIRV | SDL_GPU_SHADERFORMAT_DXIL | SDL_GPU_SHADERFORMAT_MSL, false,
+                                       backendName());
+        if (s.device == nullptr || !SDL_ClaimWindowForGPUDevice(s.device, s.window))
+        {
+            std::cerr << "[host] SDL GPU device failed: " << SDL_GetError() << std::endl;
+            return false;
+        }
+        // Without PS2X_VSYNC=1 a frame goes out at once (immediate, else mailbox); with it, at the monitor's refresh.
+        SDL_GPUPresentMode mode = SDL_GPU_PRESENTMODE_VSYNC;
+        if (!options.waitForMonitor)
+        {
+            if (SDL_WindowSupportsGPUPresentMode(s.device, s.window, SDL_GPU_PRESENTMODE_IMMEDIATE))
+                mode = SDL_GPU_PRESENTMODE_IMMEDIATE;
+            else if (SDL_WindowSupportsGPUPresentMode(s.device, s.window, SDL_GPU_PRESENTMODE_MAILBOX))
+                mode = SDL_GPU_PRESENTMODE_MAILBOX;
+        }
+        SDL_SetGPUSwapchainParameters(s.device, s.window, SDL_GPU_SWAPCHAINCOMPOSITION_SDR, mode);
+        std::cerr << "[host] SDL " << SDL_GetVersion() / 1000000 << "." << (SDL_GetVersion() / 1000) % 1000 << "."
+                  << SDL_GetVersion() % 1000 << ", GPU " << SDL_GetGPUDeviceDriver(s.device) << ", present "
+                  << presentModeName(mode) << std::endl;
+        SDL_ShowWindow(s.window);
+        return true;
+    }
+
+    void shutdown()
+    {
+        State &s = state();
+        closeAudio();
+        {
+            std::lock_guard<std::mutex> lock(s.padMutex);
+            for (SDL_Gamepad *pad : s.pads)
+                SDL_CloseGamepad(pad);
+            s.pads.clear();
+        }
+        if (s.device != nullptr)
+        {
+            SDL_WaitForGPUIdle(s.device);
+            if (s.frameTexture != nullptr)
+                SDL_ReleaseGPUTexture(s.device, s.frameTexture);
+            if (s.upload != nullptr)
+                SDL_ReleaseGPUTransferBuffer(s.device, s.upload);
+            s.frameTexture = nullptr;
+            s.upload = nullptr;
+            if (s.window != nullptr)
+                SDL_ReleaseWindowFromGPUDevice(s.device, s.window);
+            SDL_DestroyGPUDevice(s.device);
+            s.device = nullptr;
+        }
+        if (s.window != nullptr)
+        {
+            SDL_DestroyWindow(s.window);
+            s.window = nullptr;
+        }
+        SDL_Quit();
+    }
