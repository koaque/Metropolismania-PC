+    float monitorRefreshRate()
+    {
+        State &s = state();
+        if (s.window == nullptr)
+            return 0.0f;
+        const SDL_DisplayMode *mode = SDL_GetCurrentDisplayMode(SDL_GetDisplayForWindow(s.window));
+        return mode != nullptr ? mode->refresh_rate : 0.0f;
