+    // Windows: the vertical blanks are paced by timed waits, which are only as fine as the system timer. Ask for 1 ms (raylib
+    // did; SDL3 does not), and keep it and full speed in the background: since Windows 11 a process whose window is covered,
+    // minimized or out of sight gets the default timer (15.6 ms) and may be slowed down for power, unless it opts out.
+    // PS2X_POWER_THROTTLING=1 leaves Windows' default.
+    void keepTimingInBackground()
+    {
+#ifdef _WIN32
+        const char *keep = std::getenv("PS2X_POWER_THROTTLING");
+        if (keep != nullptr && keep[0] == '1')
+            return;
+        timeBeginPeriod(1);
+        PROCESS_POWER_THROTTLING_STATE throttling{};
+        throttling.Version = PROCESS_POWER_THROTTLING_CURRENT_VERSION;
+        throttling.ControlMask = PROCESS_POWER_THROTTLING_EXECUTION_SPEED | kIgnoreTimerResolution;
+        throttling.StateMask = 0; // both off: not throttled, timer requests honoured
+        SetProcessInformation(GetCurrentProcess(), ProcessPowerThrottling, &throttling, sizeof(throttling));
+#endif
+    }
+
     bool init(const WindowOptions &options)
     {
