+        if (focus)
+            SDL_SetHint(SDL_HINT_FORCE_RAISEWINDOW, "1");
         const SDL_InitFlags flags = options.headless ? SDL_INIT_EVENTS : (SDL_INIT_VIDEO | SDL_INIT_EVENTS | SDL_INIT_AUDIO | SDL_INIT_GAMEPAD);
         if (!SDL_Init(flags))
