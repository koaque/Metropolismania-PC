+    template <class Predicate>
+    bool waitUntilPrecise(std::condition_variable &cv, std::unique_lock<std::mutex> &lock,
+                          std::chrono::steady_clock::time_point deadline, Predicate predicate)
+    {
+        if (!preciseWaits() || deadline == std::chrono::steady_clock::time_point::max())
+            return cv.wait_until(lock, deadline, predicate);
+        const auto coarse = deadline - kPreciseWaitMargin;
+        if (std::chrono::steady_clock::now() < coarse && cv.wait_until(lock, coarse, predicate))
+            return true;
+        while (std::chrono::steady_clock::now() < deadline)
+        {
+            if (predicate())
+                return true;
+            lock.unlock();
+            std::this_thread::yield();
+            lock.lock();
+        }
+        return predicate();
+    }
