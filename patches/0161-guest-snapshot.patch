diff --git a/ps2xRuntime/include/runtime/ps2_guest_snapshot.h b/ps2xRuntime/include/runtime/ps2_guest_snapshot.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_guest_snapshot.h
@@ -0,0 +1,25 @@
+#pragma once
+
+// Undoable writes to a block of guest memory (RDRAM): after begin(), the first write to each page saves that page; end()
+// puts every saved page back. Used to draw extra things with the guest's own code and then leave the guest's memory as if
+// it had not run (an enhancement that must not change the game's logic). Only the thread that called begin() may write
+// the block meanwhile; another thread that writes it waits until end().
+//
+// Windows: the pages are made read-only and a vectored exception handler saves and opens each one at its first write, so
+// the cost follows the pages written. Elsewhere the whole block is copied at begin() and back at end().
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ps2x::snapshot
+{
+    // A block whose pages can be tracked (page-aligned, whole pages), zeroed; freed with freeTrackable.
+    uint8_t *allocateTrackable(size_t bytes);
+    void freeTrackable(uint8_t *block, size_t bytes);
+
+    // Starts tracking writes to the block (made with allocateTrackable). False when tracking is already on.
+    bool begin(uint8_t *block, size_t bytes);
+    // Puts back every page written since begin() and stops tracking. Returns the pages it restored.
+    size_t end();
+    bool active();
+}
diff --git a/ps2xRuntime/src/lib/ps2_guest_snapshot.cpp b/ps2xRuntime/src/lib/ps2_guest_snapshot.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_guest_snapshot.cpp
@@ -0,0 +1,162 @@
+// See runtime/ps2_guest_snapshot.h. Kept in its own file: windows.h stays out of the rest of the runtime.
+
+#include "runtime/ps2_guest_snapshot.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+namespace ps2x::snapshot
+{
+    namespace
+    {
+        constexpr size_t kPage = 4096;
+
+        struct State
+        {
+            std::atomic<bool> on{false};
+            uint8_t *block = nullptr;
+            size_t bytes = 0;
+            std::vector<uint8_t> saved;    // pages saved, in the order written
+            std::vector<uint32_t> pages;   // their indexes in the block
+            std::vector<uint8_t> written;  // per page: saved already
+#if defined(_WIN32)
+            DWORD owner = 0;
+#else
+            std::vector<uint8_t> whole;    // the whole block, at begin()
+#endif
+        };
+
+        State &state()
+        {
+            static State s;
+            return s;
+        }
+
+#if defined(_WIN32)
+        LONG CALLBACK onFault(EXCEPTION_POINTERS *info)
+        {
+            State &s = state();
+            const EXCEPTION_RECORD *record = info->ExceptionRecord;
+            if (record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || record->NumberParameters < 2 ||
+                record->ExceptionInformation[0] != 1 || !s.on.load(std::memory_order_acquire))
+                return EXCEPTION_CONTINUE_SEARCH;
+            const auto *address = reinterpret_cast<const uint8_t *>(record->ExceptionInformation[1]);
+            if (address < s.block || address >= s.block + s.bytes)
+                return EXCEPTION_CONTINUE_SEARCH;
+            if (GetCurrentThreadId() != s.owner)
+            {
+                // Not expected (the guest's code runs on one thread): wait for end(), which opens every page again.
+                while (s.on.load(std::memory_order_acquire))
+                    std::this_thread::yield();
+                return EXCEPTION_CONTINUE_EXECUTION;
+            }
+            // The page written, and the next one when the write may run into it (a store that crosses the page end can be
+            // reported at its first byte).
+            const size_t offset = static_cast<size_t>(address - s.block);
+            const size_t first = offset / kPage;
+            const size_t last = std::min((offset + 63) / kPage, s.bytes / kPage - 1);
+            for (size_t page = first; page <= last; ++page)
+            {
+                uint8_t *start = s.block + page * kPage;
+                if (s.written[page])
+                    continue;
+                s.written[page] = 1;
+                const size_t at = s.saved.size();
+                s.saved.resize(at + kPage);
+                std::memcpy(s.saved.data() + at, start, kPage);
+                s.pages.push_back(static_cast<uint32_t>(page));
+                DWORD old = 0;
+                VirtualProtect(start, kPage, PAGE_READWRITE, &old);
+            }
+            return EXCEPTION_CONTINUE_EXECUTION;
+        }
+#endif
+    }
+
+    uint8_t *allocateTrackable(size_t bytes)
+    {
+#if defined(_WIN32)
+        return static_cast<uint8_t *>(VirtualAlloc(nullptr, bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE));
+#else
+        const size_t rounded = (bytes + kPage - 1) / kPage * kPage;
+        void *block = std::aligned_alloc(kPage, rounded);
+        if (block != nullptr)
+            std::memset(block, 0, rounded);
+        return static_cast<uint8_t *>(block);
+#endif
+    }
+
+    void freeTrackable(uint8_t *block, size_t bytes)
+    {
+        (void)bytes;
+        if (block == nullptr)
+            return;
+#if defined(_WIN32)
+        VirtualFree(block, 0, MEM_RELEASE);
+#else
+        std::free(block);
+#endif
+    }
+
+    bool begin(uint8_t *block, size_t bytes)
+    {
+        State &s = state();
+        if (s.on.load(std::memory_order_acquire) || block == nullptr || bytes % kPage != 0)
+            return false;
+        s.block = block;
+        s.bytes = bytes;
+        s.saved.clear();
+        s.pages.clear();
+        s.written.assign(bytes / kPage, 0);
+#if defined(_WIN32)
+        static PVOID handler = AddVectoredExceptionHandler(1, onFault);
+        if (handler == nullptr)
+            return false;
+        if (s.saved.capacity() < 1024 * kPage)
+            s.saved.reserve(1024 * kPage);
+        s.owner = GetCurrentThreadId();
+        s.on.store(true, std::memory_order_release);
+        DWORD old = 0;
+        if (!VirtualProtect(block, bytes, PAGE_READONLY, &old))
+        {
+            s.on.store(false, std::memory_order_release);
+            return false;
+        }
+#else
+        s.whole.assign(block, block + bytes);
+        s.on.store(true, std::memory_order_release);
+#endif
+        return true;
+    }
+
+    size_t end()
+    {
+        State &s = state();
+        if (!s.on.load(std::memory_order_acquire))
+            return 0;
+#if defined(_WIN32)
+        DWORD old = 0;
+        VirtualProtect(s.block, s.bytes, PAGE_READWRITE, &old);
+        for (size_t i = 0; i < s.pages.size(); ++i)
+            std::memcpy(s.block + static_cast<size_t>(s.pages[i]) * kPage, s.saved.data() + i * kPage, kPage);
+        const size_t restored = s.pages.size();
+#else
+        std::memcpy(s.block, s.whole.data(), s.bytes);
+        const size_t restored = s.bytes / kPage;
+#endif
+        s.on.store(false, std::memory_order_release);
+        return restored;
+    }
+
+    bool active() { return state().on.load(std::memory_order_acquire); }
+}
