+PS2Memory::DeterministicTimer0State PS2Memory::saveDeterministicTimer0() noexcept
+{
+    const DeterministicTimer0 &timer = deterministicTimer0();
+    return {timer.on, timer.writes, timer.reads};
+}
+
+void PS2Memory::restoreDeterministicTimer0(const DeterministicTimer0State &state) noexcept
+{
+    DeterministicTimer0 &timer = deterministicTimer0();
+    timer.on = state.on;
+    timer.writes = state.writes;
+    timer.reads = state.reads;
+}
