+    // The deterministic timer 0 (PS2X_TIMER0=frame) as a value: whether it is on, and the count's writes and the reads since the
+    // last write, which decide what the next read returns. A test harness turns it on and starts each replayed run from the
+    // same state, so a call that reads the count (as a random number) reads the same values in every run.
+    struct DeterministicTimer0State
+    {
+        bool on = false;
+        uint32_t writes = 0, reads = 0;
+    };
+    static DeterministicTimer0State saveDeterministicTimer0() noexcept;
+    static void restoreDeterministicTimer0(const DeterministicTimer0State &state) noexcept;
 
